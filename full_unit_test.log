{\n  width: 100%;\n  overflow-x: hidden;\n}\n\nbody:not(.diagram-body) {\n  display: block;\n}\n\nbody:not(.diagram-body) .navbar {\n  left: auto;\n  right: auto;\n  width: 100%;\n  max-width: none;\n  margin: 0;\n  transform: none;\n  border-radius: 0;\n}\n\nbody:not(.diagram-body) .hero,\nbody:not(.diagram-body) .auth-layout,\nbody:not(.diagram-body) .dashboard-hero,\nbody:not(.diagram-body) .activity-shell,\nbody:not(.diagram-body) .result-screen,\nbody:not(.diagram-body) .form-card {\n  width: 100%;\n  max-width: 100%;\n}\n\nbody:not(.diagram-body) .hero {\n  min-height: min(680px, calc(100vh - 120px));\n  overflow: visible;\n  border-radius: 26px;\n  grid-template-columns: minmax(0, 1fr);\n}\n\nbody:not(.diagram-body) .hero-copy {\n  max-width: 760px;\n}\n\nbody:not(.diagram-body) .hero-mascot {\n  width: 100%;\n  min-height: 0;\n  padding: 0;\n  background: transparent;\n  box-shadow: none;\n}\n\n.phone-preview-card,\n.phone-status-preview,\n.preview-tabs,\n.preview-pill-row {\n  display: none;\n}\n\n.hero-web-preview {\n  align-content: stretch;\n  gap: 16px;\n}\n\n.web-preview-panel.reactive-koaly {\n  position: relative;\n  display: grid;\n  grid-template-columns: minmax(0, 1.2fr) minmax(220px, .8fr);\n  align-items: center;\n  gap: clamp(18px, 3vw, 34px);\n  width: 100%;\n  margin: 0;\n  min-height: 340px;\n  padding: clamp(22px, 3.5vw, 42px);\n  overflow: hidden;\n  cursor: pointer;\n  border-radius: 26px;\n  border: 1px solid rgba(255, 255, 255, .72);\n  background: linear-gradient(135deg, rgba(255, 92, 106, .16), rgba(255, 159, 28, .14) 22%, rgba(255, 210, 46, .20) 39%, rgba(48, 203, 127, .18) 56%, rgba(74, 144, 226, .18) 73%, rgba(163, 124, 243, .18)),\n    rgba(var(--surface-rgb), .94);\n  box-shadow: 0 24px 60px rgba(36, 48, 68, .14);\n}\n\n.web-preview-panel.reactive-koaly::before {\n  content: "";\n  position: absolute;\n  inset: auto -8% -28% 34%;\n  height: 58%;\n  border-radius: 999px;\n  background: linear-gradient(90deg, rgba(255, 92, 106, .22), rgba(255, 210, 46, .28), rgba(48, 203, 127, .20), rgba(74, 144, 226, .22), rgba(163, 124, 243, .22));\n  filter: blur(6px);\n  pointer-events: none;\n}\n\n.web-preview-copy,\n.web-preview-visual {\n  position: relative;\n  z-index: 1;\n}\n\n.web-preview-copy h2 {\n  margin: 16px 0 10px;\n  font-size: clamp(2rem, 4.5vw, 3.35rem);\n  line-height: 1;\n}\n\n.web-preview-copy p {\n  max-width: 560px;\n  margin: 0;\n  color: var(--auto-3f4a5c-t);\n  font-weight: 750;\n}\n\n.status-chip {\n  display: inline-flex;\n  align-items: center;\n  width: fit-content;\n  min-height: 34px;\n  padding: 8px 14px;\n  border-radius: 999px;\n  background: var(--surface);\n  color: var(--ink);\n  font-size: .84rem;\n  font-weight: 900;\n  box-shadow: 0 10px 22px rgba(36, 48, 68, .09);\n}\n\n.desktop-progress-row {\n  display: grid;\n  grid-template-columns: repeat(6, minmax(24px, 1fr));\n  gap: 8px;\n  max-width: 420px;\n  margin: 22px 0;\n}\n\n.rainbow-dot {\n  height: 12px;\n  border-radius: 999px;\n}\n\n.rainbow-dot.red { background: #ff5c6a; }\n.rainbow-dot.orange { background: #ff9f1c; }\n.rainbow-dot.yellow { background: #ffd22e; }\n.rainbow-dot.green { background: #30cb7f; }\n.rainbow-dot.blue { background: #4a90e2; }\n.rainbow-dot.violet { background: #a37cf3; }\n\n.web-preview-stats {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 10px;\n  max-width: 560px;\n}\n\n.web-preview-stats span {\n  min-height: 78px;\n  padding: 12px;\n  border-radius: 18px;\n  background: rgba(var(--surface-rgb), var(--scrim-78));\n  color: var(--auto-59647f-t);\n  font-weight: 850;\n  box-shadow: inset 0 0 0 1px rgba(217, 224, 238, .72);\n}\n\n.web-preview-stats strong {\n  display: block;\n  color: var(--ink);\n  font-size: 1.7rem;\n  line-height: 1;\n}\n\n.web-preview-visual {\n  display: grid;\n  justify-items: center;\n  gap: 12px;\n}\n\n.web-preview-visual img {\n  width: min(290px, 100%);\n  max-width: 100%;\n  filter: drop-shadow(0 26px 34px rgba(36, 48, 68, .20));\n}\n\n.web-preview-visual span {\n  display: inline-flex;\n  max-width: 260px;\n  min-height: 38px;\n  align-items: center;\n  justify-content: center;\n  padding: 9px 14px;\n  border-radius: 999px;\n  background: var(--ink);\n  color: var(--white);\n  font-size: .86rem;\n  font-weight: 900;\n  text-align: center;\n}\n\n.web-preview-dashboard {\n  display: grid;\n  gap: 12px;\n  width: 100%;\n  padding: 18px;\n  border-radius: 22px;\n  background: rgba(var(--surface-rgb), var(--scrim-86));\n  box-shadow: 0 18px 42px rgba(36, 48, 68, .10);\n}\n\n.web-preview-dashboard strong,\n.web-preview-dashboard span {\n  display: block;\n}\n\n.mini-label {\n  color: var(--muted);\n  font-size: .78rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.mini-stat-row {\n  display: grid;\n  grid-template-columns: 128px minmax(0, 1fr);\n  align-items: center;\n  gap: 12px;\n  color: var(--auto-59647f-t);\n  font-size: .88rem;\n  font-weight: 850;\n}\n\n.mini-stat-row b {\n  display: block;\n  height: 12px;\n  border-radius: 999px;\n  background: linear-gradient(90deg, #ff5c6a, #ffd22e, #30cb7f, #4a90e2, #a37cf3);\n}\n\n@keyframes koalyBreathe {\n  0%, 100% { transform: translateY(0) rotate(0deg) scale(1); }\n  50% { transform: translateY(-5px) rotate(1deg) scale(1.035); }\n}\n\n@keyframes koalyListen {\n  0%, 100% { transform: rotate(-4deg) scale(1.06); }\n  50% { transform: rotate(5deg) scale(1.1); }\n}\n\n@keyframes koalyCelebrate {\n  0% { transform: translateY(0) rotate(-3deg) scale(1.08); }\n  100% { transform: translateY(-10px) rotate(6deg) scale(1.16); }\n}\n\n@keyframes koalyEncourage {\n  0%, 100% { transform: translateY(0) scale(1.04); }\n  50% { transform: translateY(-3px) scale(1.11); }\n}\n\n.reactive-koaly.koaly-ready img {\n  animation: koalyBreathe 2.4s ease-in-out infinite;\n}\n\n.reactive-koaly.koaly-listening img {\n  animation: koalyListen .8s ease-in-out infinite;\n}\n\n.reactive-koaly.koaly-celebrating img {\n  animation: koalyCelebrate .48s ease-in