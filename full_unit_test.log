8;\n  background: rgba(var(--auto-rgb-255-237-247), .94);\n}\n\nbody:not(.diagram-body) .story-skill-row:nth-child(6n) {\n  --skill-accent: #ff5a66;\n  --skill-accent-end: #ff9f1c;\n  background: rgba(var(--auto-rgb-255-239-235), .94);\n}\n\nbody:not(.diagram-body) .story-skill-name {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  gap: 14px;\n  align-items: start;\n  min-width: 0;\n}\n\nbody:not(.diagram-body) .story-skill-name i {\n  display: grid;\n  place-items: center;\n  width: 38px;\n  height: 38px;\n  border-radius: 50%;\n  background: var(--skill-accent, #8d62e8);\n  color: var(--white);\n  font-style: normal;\n  font-weight: 950;\n}\n\nbody:not(.diagram-body) .story-skill-name strong,\nbody:not(.diagram-body) .story-skill-name span {\n  display: block;\n  overflow-wrap: anywhere;\n}\n\nbody:not(.diagram-body) .story-skill-name strong {\n  margin-bottom: 4px;\n  font-size: 1.04rem;\n}\n\nbody:not(.diagram-body) .story-skill-name span {\n  color: var(--auto-667085-t);\n  font-size: .84rem;\n  font-weight: 700;\n  line-height: 1.4;\n}\n\nbody:not(.diagram-body) .story-skill-score {\n  display: grid;\n  grid-template-columns: minmax(120px, 1fr) 48px 52px;\n  gap: 12px;\n  align-items: center;\n  min-width: 0;\n}\n\nbody:not(.diagram-body) .story-skill-score b,\nbody:not(.diagram-body) .story-skill-score > strong {\n  text-align: right;\n}\n\nbody:not(.diagram-body) .story-skill-score b {\n  color: var(--auto-667085-t);\n  font-size: .86rem;\n}\n\nbody:not(.diagram-body) .story-skill-score > strong {\n  font-size: 1.1rem;\n  color: var(--skill-accent, #8d62e8);\n}\n\nbody:not(.diagram-body) .story-skill-row .story-skill-track span {\n  background: linear-gradient(\n    90deg,\n    var(--skill-accent, #8d62e8),\n    var(--skill-accent-end, #2ab9e3)\n  );\n}\n\nbody:not(.diagram-body) .story-suggestion-list {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\nbody:not(.diagram-body) .story-suggestion-list article {\n  display: grid;\n  gap: 5px;\n  padding: 18px 20px;\n  border-left: 4px solid #2ab9e3;\n  background: linear-gradient(90deg, var(--auto-eaf9ff-bg), var(--auto-edf9f3-bg));\n}\n\nbody:not(.diagram-body) .story-suggestion-list article:nth-child(even) {\n  border-left-color: #ef7ac8;\n  background: linear-gradient(90deg, var(--auto-fff0f7-bg), var(--auto-f4efff-bg));\n}\n\nbody:not(.diagram-body) .story-suggestion-list span {\n  color: var(--auto-526071-t);\n  font-size: .88rem;\n  font-weight: 700;\n  line-height: 1.4;\n}\n\nbody:not(.diagram-body) .story-diary-report {\n  display: grid;\n  gap: 16px;\n  padding-top: 8px;\n}\n\nbody:not(.diagram-body) .story-diary-heading {\n  display: flex;\n  align-items: end;\n  justify-content: space-between;\n  gap: 18px;\n}\n\nbody:not(.diagram-body) .story-diary-heading h2 {\n  margin: 4px 0 0;\n  color: var(--auto-172033-t);\n  font-size: 1.55rem;\n  letter-spacing: 0;\n}\n\nbody:not(.diagram-body) .story-diary-heading > span {\n  color: var(--auto-667085-t);\n  font-size: .85rem;\n  font-weight: 800;\n}\n\nbody:not(.diagram-body) .story-diary-paper {\n  display: grid;\n  gap: 12px;\n  padding: 24px;\n  border: 1px solid var(--auto-d7c7e9-bd);\n  border-left: 6px solid #8d62e8;\n  border-radius: 8px;\n  background: repeating-linear-gradient(\n      var(--surface),\n      var(--surface) 39px,\n      var(--auto-dce9f5-bg) 40px\n    );\n  color: var(--auto-33415f-t);\n}\n\nbody:not(.diagram-body) .story-diary-paper > strong {\n  color: var(--auto-23304a-t);\n  font-size: 1.08rem;\n}\n\nbody:not(.diagram-body) .story-diary-paper p {\n  margin: 0;\n  line-height: 1.65;\n}\n\nbody:not(.diagram-body) .story-diary-signature {\n  color: var(--auto-14624c-t);\n  font-weight: 900;\n}\n\n@media (max-width: 780px) {\n  body:not(.diagram-body) .story-progress-header,\n  body:not(.diagram-body) .story-detail-header,\n  body:not(.diagram-body) .story-list-heading,\n  body:not(.diagram-body) .story-skill-heading {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  body:not(.diagram-body) .story-progress-summary {\n    grid-template-columns: auto minmax(0, 1fr);\n    padding: 18px;\n  }\n\n  body:not(.diagram-body) .story-library-tools {\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  }\n\n  body:not(.diagram-body) .story-tools-submit,\n  body:not(.diagram-body) .story-tools-clear {\n    width: 100%;\n  }\n\n  body:not(.diagram-body) .story-progress-stars {\n    grid-column: 2;\n    justify-items: start;\n  }\n\n  body:not(.diagram-body) .story-report-row {\n    grid-template-columns: 76px minmax(0, 1fr) auto;\n    gap: 12px;\n    min-height: 104px;\n    padding: 12px;\n  }\n\n  body:not(.diagram-body) .story-report-cover {\n    width: 76px;\n    height: 76px;\n  }\n\n  body:not(.diagram-body) .story-report-result {\n    grid-column: 3;\n    grid-row: 1;\n  }\n\n  body:not(.diagram-body) .story-report-action {\n    grid-column: 2 / 4;\n    justify-self: start;\n    text-align: left;\n  }\n\n  body:not(.diagram-body) .story-detail-summary,\n  body:not(.diagram-body) .story-suggestion-list {\n    grid-template-columns: 1fr;\n  }\n\n  body:not(.diagram-body) .story-detail-summary article {\n    min-height: 105px;\n    border-right: 0;\n    border-bottom: 1px solid var(--auto-d9e2ee-bd);\n  }\n\n  body:not(.diagram-body) .story-detail-summary article:last-child {\n    border-bottom: 0;\n  }\n\n  body:not(.diagram-body) .story-skill-row {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 14px;\n  }\n\n  body:not(.diagram-body) .story-diary-heading {\n    align-items: start;\n    flex-direction: column;\n  }\n}\n\n@media (max-width: 480px) {\n  body:not(.diagram-body) .story-progress-page,\n  body:not(.diagram-body) .story-detail-page {\n    gap: 20px;\n  }\n\n  body:not(.diagram-body) .story-progress-header h1,\n  body:not(.diagram-body) .story-detail-header h1 {\n    font-size: 2.25rem;\n  }\n\n  body:not(.diagram-body) .story-detail-identity {\n    grid-template-columns: 1fr;\n    gap: 14px;\n    padding: 20px;\n  }\n\n  body:not(.diagram-body) .story-detail-avatar {\n    width: 78px;\n    height: 78px;\n    border-width: 4px;\n    font-size: 1.8rem;\n  }\n\n  body:not(.diagram-body) .story-progress-summary {\n    grid-template-columns: 1fr;\n  }\n\n  body:not(.diagram-body) .story-library-tools {\n    grid-template-columns: 1fr;\n    padding: 14px;\n  }\n\n  body:not(.diagram-body) .story-results-count {\n    margin-top: -8px;\n    text-align: left;\n  }\n\n  body:not(.diagram-body) .story-progress-stars {\n    grid-column: 1;\n  }\n\n  body:not(.diagram-body) .story-report-row {\n    grid-template-columns: 64px minmax(0, 1fr);\n  }\n\n  body:not(.diagram-body) .story-report-cover {\n    width: 64px;\n    height: 64px;\n  }\n\n  body:not(.diagram-body) .story-report-result,\n  body:not(.diagram-body) .story-report-action {\n    grid-column: 2;\n    grid-row: auto;\n    justify-self: start;\n    justify-items: start;\n  }\n\n  body:not(.diagram-body) .story-focus-callout {\n    grid-template-columns: 1fr;\n  }\n\n  body:not(.diagram-body) .story-skill-row {\n    padding: 16px;\n  }\n\n  body:not(.diagram-body) .story-skill-score {\n    grid-template-columns: minmax(0, 1fr) auto;\n  }\n\n  body:not(.diagram-body) .story-skill-track {\n    grid-column: 1 / -1;\n    grid-row: 2;\n  }\n}\n}\n\n@layer pages {\n  /* Cause and effect */\n  .cause-effect-grid { display:grid; grid-template-columns:1fr 1fr; gap:0.8rem; margin-top:1rem; }\n  .cause-card, .effect-card {\n    background: var(--surface, var(--surface));\n    border: 2px solid var(--border, var(--auto-dddddd-bd));\n    border-radius: 10px;\n    padding: 0.75rem 0.9rem;\n    font-size: 0.92rem;\n    cursor: pointer;\n    min-height: 60px;\n    display:flex; align-items:center;\n  }\n  .cause-card { border-color: #818cf8; background: var(--auto-eef2ff-bg); }\n  .effect-card { border-color: #34d399; background: var(--auto-ecfdf5-bg); }\n  .cause-card.selected  { border-width: 3px; box-shadow: 0 0 0 3px #818cf840; }\n  .effect-card.selected { border-width: 3px; box-shadow: 0 0 0 3px #34d39940; }\n  .pair-correct { border-color: #22c55e; background: var(--auto-f0fdf4-bg); }\n  .pair-wrong   { border-color: #ef4444; background: var(--auto-fef2f2-bg); }\n\n  /* Chat */\n  .chat-page {\n    max-width: 720px; margin: 0 auto;\n    display: flex; flex-direction: column;\n    height: calc(100vh - 80px);\n  }\n\n  .chat-topbar {\n    display: flex; align-items: center; gap: 14px;\n    padding: 12px 16px; border-bottom: 1px solid var(--auto-e5e7eb-bd); background: var(--surface);\n  }\n  .chat-back { color: var(--auto-6c3ed4-t); text-decoration: none; font-weight: 700; font-size: .9rem; white-space: nowrap; }\n  .chat-back:hover { text-decoration: underline; }\n  .chat-topbar-info { display: flex; flex-direction: column; }\n  .chat-topbar-info strong { font-size: .95rem; }\n  .chat-topbar-info span { font-size: .78rem; color: var(--auto-6b7280-t); }\n\n  .chat-learner-banner {\n    display: flex; align-items: center; gap: 12px;\n    padding: 10px 16px; background: var(--auto-f5f0ff-bg); border-bottom: 1px solid var(--auto-ddd6fe-bd);\n  }\n  .chat-learner-avatar {\n    width: 36px; height: 36px; border-radius: 50%; flex-shrink: 0;\n    background: var(--auto-ede9fe-bg); color: var(--auto-5b21b6-t);\n    display: flex; align-items: center; justify-content: center; font-weight: 700;\n  }\n  .chat-learner-name { font-size: .88rem; font-weight: 700; color: var(--auto-3c3489-t); }\n  .chat-learner-stats { font-size: .75rem; color: var(--auto-6d28d9-t); }\n  .chat-view-report {\n    margin-left: auto; font-size: .78rem; color: var(--auto-6c3ed4-t);\n    text-decoration: none; border: 1px solid var(--auto-c4b5fd-bd); border-radius: 8px;\n    padding: 4px 10px; white-space: nowrap;\n  }\n  .chat-view-report:hover { background: var(--auto-ede9fe-bg); }\n\n  .chat-messages {\n    flex: 1; overflow-y: auto;\n    padding: 16px; display: flex; flex-direction: column; gap: 12px;\n    background: var(--auto-f9fafb-bg);\n  }\n  .chat-empty { text-align: center; color: #9ca3af; font-size: .88rem; margin: auto; }\n\n  .chat-bubble-wrap { display: flex; gap: 8px; align-items: flex-end; }\n  .chat-bubble-wrap.mine { flex-direction: row-reverse; }\n\n  .chat-bubble-avatar {\n    width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;\n    background: var(--auto-e0e7ff-bg); color: var(--auto-3730a3-t);\n    display: flex; align-items: center; justify-content: center;\n    font-size: .75rem; font-weight: 700;\n  }\n  .chat-bubble-col { display: flex; flex-direction: column; max-width: 75%; }\n  .chat-bubble {\n    padding: 10px 14px; border-radius: 16px;\n    font-size: .9rem; line-height: 1.5; word-break: break-word;\n  }\n  .chat-bubble--theirs { background: var(--surface); border: 1px solid var(--auto-e5e7eb-bd); border-bottom-left-radius: 4px; }\n  .chat-bubble--mine { background: #6c3ed4; color: var(--white); border-bottom-right-radius: 4px; }\n  .chat-bubble-time { font-size: .68rem; color: #9ca3af; margin-top: 3px; padding: 0 4px; }\n  .chat-bubble-time--right { text-align: right; }\n\n  .chat-input-bar {\n    display: flex; gap: 10px; align-items: flex-end;\n    padding: 12px 16px; border-top: 1px solid var(--auto-e5e7eb-bd); background: var(--surface);\n  }\n  .chat-input {\n    flex: 1; border: 1px solid var(--auto-d1d5db-bd); border-radius: 12px;\n    padding: 10px 14px; font-size: .9rem; resize: none; font-family: inherit;\n    line-height: 1.4; max-height: 120px; overflow-y: auto;\n    transition: border-color .15s;\n  }\n  .chat-input:focus { outline: none; border-color: #6c3ed4; }\n  .chat-send-btn {\n    width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;\n    background: #6c3ed4; color: var(--white); border: none; font-size: 1.1rem;\n    cursor: pointer; display: flex; align-items: center; justify-content: center;\n    transition: background .15s, transform .1s;\n  }\n  .chat-send-btn:hover { background: #5b21b6; }\n  .chat-send-btn:active { transform: scale(0.94); }\n  .chat-send-btn:disabled { background: #d1d5db; cursor: not-allowed; }\n\n  /* Conversations */\n  .conv-page { max-width: 700px; margin: 0 auto; padding: 2rem 1rem; }\n  .conv-header { margin-bottom: 1.75rem; }\n  .conv-header h1 { font-size: 1.6rem; margin: 0 0 .3rem; }\n  .conv-header p { color: var(--auto-6b7280-t); margin: 0; font-size: .95rem; }\n\n  .conv-grid { display: flex; flex-direction: column; gap: 12px; }\n\n  .conv-card {\n    display: flex; align-items: center; gap: 16px;\n    background: var(--surface); border: 1.5px solid var(--auto-e5e7eb-bd); border-radius: 16px;\n    padding: 16px 18px; text-decoration: none; color: inherit;\n    transition: border-color .15s, box-shadow .15s, transform .1s;\n  }\n  .conv-card:hover {\n    border-color: #6c3ed4;\n    box-shadow: 0 4px 18px rgba(108,62,212,.12);\n    transform: translateY(-1px);\n  }\n  .conv-card--unread { border-left: 4px solid #6c3ed4; background: var(--auto-faf8ff-bg); }\n\n  .conv-avatar {\n    width: 54px; height: 54px; border-radius: 50%; flex-shrink: 0;\n    background: linear-gradient(135deg, var(--auto-ede9fe-bg), var(--auto-ddd6fe-bg));\n    color: var(--auto-5b21b6-t); font-size: 1.3rem; font-weight: 800;\n    display: flex; align-items: center; justify-content: center;\n  }\n\n  .conv-info { flex: 1; min-width: 0; }\n  .conv-name { font-size: 1rem; font-weight: 700; color: var(--auto-111827-t); margin-bottom: 2px; }\n  .conv-grade { font-size: .8rem; color: var(--auto-6b7280-t); margin-bottom: 4px; }\n  .conv-other { font-size: .82rem; color: var(--auto-374151-t); }\n  .conv-other-label { color: #9ca3af; font-size: .78rem; }\n\n  .conv-right {\n    display: flex; flex-direction: column; align-items: flex-end; gap: 4px;\n    min-width: 110px; max-width: 140px;\n  }\n  .conv-badge {\n    background: #6c3ed4; color: var(--white); border-radius: 99px;\n    font-size: .72rem; font-weight: 700; padding: 3px 9px;\n  }\n  .conv-preview {\n    font-size: .78rem; color: var(--auto-4b5563-t); text-align: right;\n    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 130px;\n  }\n  .conv-preview--empty { font-style: italic; color: #9ca3af; }\n  .conv-time { font-size: .7rem; color: #9ca3af; }\n  .conv-arrow { font-size: 1.4rem; color: var(--auto-6c3ed4-t); line-height: 1; }\n\n  .conv-empty {\n    text-align: center; padding: 3.5rem 1.5rem;\n    border: 2px dashed var(--auto-e5e7eb-bd); border-radius: 16px; color: var(--auto-6b7280-t);\n  }\n  .conv-empty-icon { font-size: 2.5rem; margin-bottom: .75rem; }\n  .conv-empty strong { display: block; font-size: 1.05rem; color: var(--auto-374151-t); margin-bottom: .5rem; }\n  .conv-empty p { font-size: .9rem; max-width: 380px; margin: 0 auto; }\n\n  @media (max-width: 540px) {\n    .conv-right { min-width: unset; max-width: unset; width: 100%; flex-direction: row; justify-content: space-between; align-items: center; }\n  }\n\n  /* Prediction */\n  .stop-point-box {\n    background: var(--surface, var(--auto-f8f8ff-bg));\n    border-left: 4px solid var(--primary, #6c63ff);\n    border-radius: 8px;\n    padding: 0.85rem 1.1rem;\n    margin-bottom: 1.1rem;\n    font-style: italic;\n    color: var(--text-muted, var(--auto-555555-t));\n    font-size: 0.97rem;\n  }\n\n  /* Registration */\n  .terms-notice {\n      font-size: 0.82rem;\n      color: var(--auto-6b7280-t);\n      margin: 0.25rem 0 0.75rem;\n      text-align: center;\n      line-height: 1.5;\n    }\n    .terms-link {\n      color: #3b82f6;\n      font-weight: 600;\n      text-decoration: underline;\n      text-underline-offset: 2px;\n      cursor: pointer;\n      transition: color 0.15s ease;\n    }\n    .terms-link:hover {\n      color: var(--auto-1d4ed8-t);\n    }\n\n  /* Grade 4 results */\n  .total-score-line {\n    font-size: 1.1rem;\n    margin: 0.5rem 0 1.5rem;\n    color: var(--text, var(--auto-111111-t));\n  }\n\n  /* Highlights: best 2 / worst 2 */\n  .g4-highlights {\n    display: flex;\n    gap: 1rem;\n    flex-wrap: wrap;\n    justify-content: center;\n    margin: 0 auto 1.5rem;\n    max-width: 520px;\n  }\n  .g4-highlight-group {\n    flex: 1;\n    min-width: 210px;\n  }\n  .g4-group-label {\n    font-size: 0.78rem;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n    margin: 0 0 0.5rem;\n  }\n  .g4-best-label  { color: var(--auto-16a34a-t); }\n  .g4-focus-label { color: var(--auto-ea580c-t); }\n\n  .g4-highlight-card {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    border-radius: 10px;\n    padding: 0.55rem 0.85rem;\n    margin-bottom: 0.4rem;\n    font-weight: 600;\n    font-size: 0.9rem;\n  }\n  .g4-best  { background: var(--auto-dcfce7-bg); color: var(--auto-166534-t); }\n  .g4-focus { background: var(--auto-fff3e0-bg); color: var(--auto-9a3412-t); }\n  .g4-hl-name { flex: 1; }\n  .g4-hl-pct  { font-size: 1rem; font-weight: 700; }\n\n  /* Breakdown bars */\n  .g4-breakdown {\n    background: var(--surface, var(--surface));\n    border-radius: 16px;\n    padding: 1.2rem 1.4rem;\n    margin: 1rem auto 1.5rem;\n    max-width: 500px;\n    box-shadow: 0 2px 12px rgba(0,0,0,0.07);\n  }\n  .g4-breakdown h2 {\n    font-size: 1rem;\n    font-weight: 700;\n    margin: 0 0 1rem;\n    color: var(--text-muted, var(--auto-555555-t));\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n  }\n  .breakdown-list {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 0.65rem;\n  }\n  .breakdown-item {\n    display: grid;\n    grid-template-columns: minmax(170px, 0.9fr) minmax(140px, 1.3fr) 54px;\n    align-items: center;\n    gap: 0.6rem;\n  }\n  .breakdown-label {\n    font-size: 0.88rem;\n    font-weight: 600;\n    color: var(--text, var(--auto-111111-t));\n    min-width: 0;\n    line-height: 1.25;\n    overflow-wrap: anywhere;\n  }\n  .breakdown-bar-wrap {\n    background: var(--border, var(--auto-e5e7eb-bg));\n    border-radius: 999px;\n    height: 10px;\n    overflow: hidden;\n  }\n  .breakdown-bar {\n    display: block;\n    height: 100%;\n    border-radius: 999px;\n    background: var(--primary, #6c63ff);\n    transition: width 0.6s ease;\n  }\n  .breakdown-fraction {\n    font-size: 0.82rem;\n    font-weight: 700;\n    text-align: right;\n  }\n  .breakdown-fraction.all-correct  { color: var(--auto-22c55e-t); }\n  .breakdown-fraction.none-correct { color: #ef4444; }\n  .breakdown-fraction.some-correct { color: var(--auto-f59e0b-t); }\n\n  @media (max-width: 560px) {\n    .g4-breakdown {\n      padding: 1.1rem;\n    }\n    .breakdown-item {\n      grid-template-columns: minmax(0, 1fr) auto;\n      gap: 0.4rem 0.75rem;\n    }\n    .breakdown-label {\n      font-size: 0.84rem;\n    }\n    .breakdown-bar-wrap {\n      grid-column: 1 / -1;\n      grid-row: 2;\n    }\n  }\n\n  /* Legacy sequencing */\n  .sequencing-page .sequence-list { list-style:none; padding:0; margin:1rem 0; }\n  .sequencing-page .sequence-list li {\n    background: var(--surface, var(--surface));\n    border: 2px solid var(--border, var(--auto-dddddd-bd));\n    border-radius: 10px;\n    padding: 0.75rem 1rem;\n    margin-bottom: 0.6rem;\n    cursor: grab;\n    font-size: 1rem;\n    user-select: none;\n  }\n  .sequencing-page .sequence-list li.drag-over { border-color: var(--primary, #6c63ff); background: var(--primary-light, var(--auto-f0eeff-bg)); }\n  .sequencing-page .seq-correct { border-color: #22c55e; background: var(--auto-f0fdf4-bg); }\n  .sequencing-page .seq-wrong   { border-color: #ef4444; background: var(--auto-fef2f2-bg); }\n\n  /* Terms */\n  .terms-page {\n      padding: 2rem 1rem 4rem;\n      background: var(--auto-f9fafb-bg);\n      min-height: 80vh;\n    }\n    .terms-container {\n      max-width: 780px;\n      margin: 0 auto;\n      background: var(--surface);\n      border-radius: 1rem;\n      box-shadow: 0 2px 12px rgba(0,0,0,0.07);\n      overflow: hidden;\n    }\n    .terms-header {\n      display: flex;\n      align-items: center;\n      gap: 1.25rem;\n      padding: 2rem 2.5rem 1.5rem;\n      background: linear-gradient(135deg, var(--auto-e0f2fe-bg) 0%, var(--auto-dbeafe-bg) 100%);\n      border-bottom: 1px solid var(--auto-bfdbfe-bd);\n    }\n    .terms-koaly {\n      width: 64px;\n      height: 64px;\n      object-fit: contain;\n      flex-shrink: 0;\n    }\n    .terms-header h1 {\n      margin: 0.1rem 0 0.2rem;\n      font-size: 1.6rem;\n      color: var(--auto-1e3a5f-t);\n    }\n    .terms-meta {\n      font-size: 0.82rem;\n      color: var(--auto-64748b-t);\n      margin: 0;\n    }\n  .terms-page .eyebrow {\n      font-size: 0.75rem;\n      font-weight: 700;\n      letter-spacing: 0.08em;\n      text-transform: uppercase;\n      color: #3b82f6;\n      margin: 0 0 0.15rem;\n    }\n    .terms-body {\n      padding: 2rem 2.5rem 2.5rem;\n      color: var(--auto-374151-t);\n      font-size: 0.95rem;\n      line-height: 1.7;\n    }\n    .terms-body h2 {\n      font-size: 1.1rem;\n      color: var(--auto-1e3a5f-t);\n      margin: 2rem 0 0.5rem;\n      border-bottom: 2px solid var(--auto-e0f2fe-bd);\n      padding-bottom: 0.3rem;\n    }\n    .terms-body h3 {\n      font-size: 0.97rem;\n      color: var(--auto-1e40af-t);\n      margin: 1.25rem 0 0.4rem;\n    }\n    .terms-body p { margin: 0.5rem 0 0.75rem; }\n    .terms-body ul {\n      padding-left: 1.4rem;\n      margin: 0.4rem 0 0.8rem;\n    }\n    .terms-body ul li { margin-bottom: 0.3rem; }\n    .terms-body a { color: #3b82f6; text-decoration: underline; }\n    .terms-footer-note {\n      margin-top: 2.5rem;\n      font-size: 0.78rem;\n      color: #9ca3af;\n      text-align: center;\n    }\n    @media (max-width: 600px) {\n      .terms-header { padding: 1.5rem 1.25rem 1.25rem; flex-direction: column; text-align: center; }\n      .terms-body { padding: 1.25rem 1.25rem 2rem; }\n    }\n\n  /* OTP verification */\n  /* \u2500\u2500 OTP digit boxes \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .otp-boxes {\n    display: flex;\n    gap: 10px;\n    justify-content: center;\n  }\n\n  .otp-digit {\n    width: 52px;\n    height: 62px;\n    text-align: center;\n    font-size: 1.6rem;\n    font-weight: 900;\n    color: var(--ink);\n    background: var(--surface);\n    border: 2px solid var(--line);\n    border-radius: var(--radius);\n    outline: none;\n    transition: border-color .18s ease, box-shadow .18s ease;\n    caret-color: var(--sun);\n  }\n\n  .otp-digit:focus {\n    border-color: var(--sun);\n    box-shadow: 0 0 0 3px rgba(248, 200, 75, .25);\n  }\n\n  .otp-digit.filled {\n    border-color: var(--mint);\n    background: var(--mint-soft);\n  }\n\n  /* Link-style button for resend */\n  .link-btn {\n    background: none;\n    border: none;\n    padding: 0;\n    color: var(--success);\n    font-weight: 700;\n    cursor: pointer;\n    font-size: inherit;\n    text-decoration: underline;\n  }\n  .link-btn:disabled { color: var(--muted); text-decoration: none; cursor: default; }\n\n  @media (max-width: 600px) {\n    .otp-digit { width: 42px; height: 52px; font-size: 1.3rem; }\n    .otp-boxes { gap: 7px; }\n  }\n\n  /* Written response */\n  .writing-textarea {\n    width: 100%;\n    border: 2px solid var(--border, var(--auto-dddddd-bd));\n    border-radius: 10px;\n    padding: 0.85rem 1rem;\n    font-size: 1rem;\n    font-family: inherit;\n    resize: vertical;\n    box-sizing: border-box;\n    background: var(--surface, var(--surface));\n    color: var(--text, var(--auto-111111-t));\n    margin-top: 0.5rem;\n  }\n  .writing-textarea:focus {\n    outline: none;\n    border-color: var(--primary, #6c63ff);\n  }\n\n  .activity-action-row { margin-top: 1.2rem; }\n  .activity-results-row { margin-top: 1rem; }\n  .written-instruction {\n    margin-bottom: .8rem;\n    color: var(--text-muted, var(--auto-666666-t));\n    font-size: .9rem;\n  }\n\n  .password-role-tabs { margin-top: 1.5rem; }\n  .password-role-tabs.is-disabled { pointer-events: none; }\n  .password-success { padding: 2rem 0; text-align: center; }\n  .password-success-icon { margin-bottom: 1rem; font-size: 3rem; }\n  .password-success-copy { margin: 1rem 0 1.5rem; }\n  .password-help-copy { margin-bottom: 1.5rem; }\n  .auth-link-button {\n    display: block;\n    margin-top: 1.5rem;\n    text-align: center;\n    text-decoration: none;\n  }\n  .auth-submit-spaced { margin-top: 1rem; }\n  .auth-back-link { margin-top: 1rem; text-align: center; }\n  .login-help-link { margin-top: -.5rem; text-align: right; }\n  .password-mismatch {\n    margin-top: -.5rem;\n    color: var(--auto-c0392b-t);\n    font-size: .875rem;\n  }\n\n  .otp-expiry-note { margin-top: 1rem; }\n  .otp-instruction { margin-bottom: 1.5rem; font-size: .95rem; }\n  .otp-submit { margin-top: 1.5rem; }\n  .otp-resend-form { margin-top: 1rem; text-align: center; }\n  .resend-timer { color: var(--muted); font-size: .85rem; }\n  .otp-start-over { margin-top: 1rem; text-align: center; }\n\n  .role-tile-learner,\n  .role-tile-parent,\n  .role-tile-teacher {\n    width: 20rem;\n    border-width: thick;\n  }\n  .role-tile-learner { border-color: var(--auto-ffe68a-bd); background-color: #ffd22e; }\n  .role-tile-parent { border-color: var(--auto-9cbbff-bd); background-color: #83a8f6; }\n  .role-tile-teacher { border-color: var(--auto-94fef5-bd); background-color: #5bdad4; }\n\n  .lr-bar-fill,\n  .breakdown-bar,\n  .mobile-progress span {\n    width: min(var(--progress, 0%), 100%);\n  }\n}\n\n@layer pages {\n  .nav-messages-link { position: relative; }\n  .nav-unread-badge {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 16px;\n    height: 16px;\n    padding: 0 4px;\n    margin-left: 4px;\n    border-radius: 999px;\n    background: #a30d0d;\n    color: var(--white);\n    font-size: .68rem;\n    font-weight: 700;\n    line-height: 1;\n    vertical-align: 2px;\n  }\n\n  .password-strength { margin: 6px 0; }\n  .strength-bar {\n    width: 100%;\n    height: 6px;\n    overflow: hidden;\n    border-radius: 3px;\n    background: var(--auto-e5e7eb-bg);\n  }\n  .strength-bar-fill {\n    width: 0;\n    height: 100%;\n    background: #ef4444;\n    transition: width .2s ease, background-color .2s ease;\n  }\n  .strength-bar-fill[data-strength="weak"] { width: 25%; background: #ef4444; }\n  .strength-bar-fill[data-strength="okay"] { width: 60%; background: #f59e0b; }\n  .strength-bar-fill[data-strength="strong"] { width: 85%; background: #16a34a; }\n  .strength-bar-fill[data-strength="very-strong"] { width: 100%; background: #15803d; }\n  .strength-label {\n    display: inline-block;\n    margin-top: 4px;\n    font-size: .85rem;\n    font-weight: 600;\n  }\n  .strength-label[data-strength="weak"] { color: #ef4444; }\n  .strength-label[data-strength="okay"] { color: var(--auto-b45309-t); }\n  .strength-label[data-strength="strong"] { color: var(--auto-16a34a-t); }\n  .strength-label[data-strength="very-strong"] { color: var(--auto-15803d-t); }\n  .password-requirements {\n    margin: 6px 0 4px;\n    padding: 0;\n    list-style: none;\n    font-size: .82rem;\n  }\n  .password-requirements li { padding: 1px 0; color: #9ca3af; }\n  .password-requirements li::before { content: "\\2715  "; }\n  .password-requirements li.met { color: var(--auto-16a34a-t); }\n  .password-requirements li.met::before { content: "\\2713  "; }\n  .password-suggestion {\n    margin: 6px 0;\n    padding: 6px 8px;\n    border: 1px solid var(--auto-fde68a-bd);\n    border-radius: 6px;\n    color: var(--auto-b45309-t);\n    background: var(--auto-fffbeb-bg);\n    font-size: .82rem;\n  }\n  .form-card label.terms-checkbox-label {\n    display: inline-flex;\n    flex-flow: row nowrap;\n    align-items: center;\n    gap: 6px;\n    margin: 14px 0;\n    white-space: nowrap;\n    font-size: .9rem;\n    line-height: 1.3;\n    cursor: pointer;\n  }\n  .form-card label.terms-checkbox-label input[type="checkbox"] {\n    flex: 0 0 16px;\n    width: 16px;\n    min-width: 16px;\n    max-width: 16px;\n    height: 16px;\n    min-height: 16px;\n    max-height: 16px;\n    margin: 0;\n    appearance: auto;\n    cursor: pointer;\n  }\n  .form-card label.terms-checkbox-label .terms-link {\n    display: inline;\n    white-space: nowrap;\n  }\n  button[disabled] { opacity: .55; cursor: not-allowed; }\n  .password-field-wrap { position: relative; display: flex; align-items: center; }\n  .password-field-wrap input[type="password"],\n  .password-field-wrap input[type="text"] { flex: 1; padding-right: 60px; }\n  .password-toggle-visibility {\n    position: absolute;\n    right: 8px;\n    padding: 4px 6px;\n    border: 0;\n    color: var(--auto-2563eb-t);\n    background: none;\n    font-size: .78rem;\n    font-weight: 600;\n    cursor: pointer;\n  }\n  .generate-password-btn,\n  .copy-password-btn {\n    display: inline-block;\n    padding: 6px 10px;\n    border-radius: 6px;\n    font-size: .82rem;\n    font-weight: 600;\n    cursor: pointer;\n  }\n  .generate-password-btn {\n    border: 1px solid var(--auto-c7d2fe-bd);\n    color: var(--auto-4338ca-t);\n    background: var(--auto-eef2ff-bg);\n  }\n  .generate-password-btn:hover { background: var(--auto-e0e7ff-bg); }\n  .generate-password-btn:active,\n  .copy-password-btn:active { transform: translateY(1px); }\n  .password-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 6px 0 4px; }\n  .copy-password-btn {\n    border: 1px solid var(--auto-bbf7d0-bd);\n    color: var(--auto-15803d-t);\n    background: var(--auto-f0fdf4-bg);\n  }\n  .copy-password-btn:hover { background: var(--auto-dcfce7-bg); }\n  .copy-password-btn.copied { border-color: #16a34a; color: var(--white); background: #16a34a; }\n\n  .epic-band {\n    position: relative;\n    left: 50%;\n    right: 50%;\n    width: 100vw;\n    margin-right: -50vw;\n    margin-left: -50vw;\n    padding: 56px 24px 64px;\n    overflow: visible;\n    background: transparent;\n    text-align: center;\n  }\n  .epic-band h1 {\n    margin: 0 0 40px;\n    color: var(--ink);\n    font-size: clamp(1.7rem, 3.4vw, 2.5rem);\n    font-weight: 900;\n  }\n  .subscription-koaly-peek {\n    top: -18px;\n    right: clamp(24px, 8vw, 90px);\n    bottom: auto;\n  }\n  .subscription-parent-summary {\n    max-width: 700px;\n    margin: 16px auto 0;\n    color: var(--muted);\n    font-size: 1.35rem;\n    font-weight: 800;\n    line-height: 1.4;\n  }\n  .epic-cards {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    /* Stated explicitly rather than left as the flex default: the three plan\n       cards must render at one identical height so their bottom-aligned CTAs\n       line up and no card shows a gap above its button. */\n    align-items: stretch;\n    gap: 26px;\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n  .epic-card {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 6px;\n    width: 320px;\n    padding: 44px 32px 32px;\n    border-radius: 20px;\n    background: var(--surface);\n    box-shadow: 0 18px 34px rgba(20, 40, 50, .16);\n  }\n  .epic-ribbon {\n    position: absolute;\n    top: 22px;\n    left: -10px;\n    padding: 9px 18px 9px 22px;\n    color: var(--ink);\n    background: var(--sun);\n    clip-path: polygon(0 0, 100% 0, 100% 100%, 12px 100%, 0 70%);\n    font-size: .82rem;\n    font-weight: 800;\n    letter-spacing: .02em;\n    text-transform: uppercase;\n  }\n  .epic-plan-name {\n    margin: 6px 0 0;\n    color: var(--ink);\n    font-size: 1.5rem;\n    font-weight: 900;\n    letter-spacing: .03em;\n    text-transform: uppercase;\n  }\n  .epic-card-individual .epic-plan-name,\n  .subscription-school-heading { color: var(--auto-b8860b-t); }\n  .epic-card-family .epic-plan-name,\n  .subscription-package-heading { color: var(--lavender); }\n  .epic-card-enterprise .epic-plan-name,\n  .subscription-government-heading { color: var(--success); }\n  .epic-price {\n    margin: 4px 0 0;\n    color: var(--ink);\n    font-size: 2.6rem;\n    font-weight: 900;\n  }\n  .epic-price span { color: var(--muted); font-size: 1rem; font-weight: 700; }\n  /* The Enterprise price carries two extra qualifiers ("From" and\n     "/month per learner") around the amount, which is more text than the other\n     two cards\' "R49/month" and "R89/month". At the full qualifier size that\n     line overflows a 320px card and wraps, which makes the Enterprise card\n     taller than its neighbours � and because every card\'s CTA is pinned to the\n     bottom with `margin-top: auto`, the extra height shows up as dead space\n     above the Individual and Family buttons. Shrinking only the qualifiers (not\n     the amount) keeps the price figure the same size as the other two cards\n     while fitting the whole line on one row. */\n  .epic-card-enterprise .epic-price span { font-size: .75rem; }\n  @media (min-width: 721px) {\n    /* Desktop cards are a fixed 320px wide, where the line above now fits. */\n    .epic-card-enterprise .epic-price { white-space: nowrap; }\n  }\n  /* Below 720px the cards stack and size to their own content, so a wrap there\n     costs nothing and lets long qualifiers shrink rather than overflow. */\n  .epic-billed {\n    margin: 0 0 22px;\n    color: var(--muted);\n    font-size: .92rem;\n    font-weight: 600;\n  }\n  .epic-billed-tight { margin-bottom: 4px; }\n  .epic-billed-copy { margin-bottom: 8px; }\n  .epic-billed-top { margin-top: 10px; }\n  .epic-tier-list {\n    display: grid;\n    gap: 8px;\n    width: 100%;\n    margin: 0;\n    padding: 0;\n    list-style: none;\n    text-align: left;\n  }\n  .epic-tier-list li {\n    position: relative;\n    padding-left: 24px;\n    color: var(--muted);\n    font-size: .92rem;\n    font-weight: 600;\n  }\n  .epic-tier-list li::before {\n    position: absolute;\n    top: 0;\n    left: 0;\n    color: var(--success);\n    content: "\\2713";\n    font-weight: 900;\n  }\n  .epic-cta {\n    width: 100%;\n    margin-top: auto;\n    padding: 15px 26px;\n    border: 0;\n    border-radius: 999px;\n    font-size: 1rem;\n    font-weight: 800;\n    cursor: pointer;\n    transition: transform .15s ease, box-shadow .15s ease;\n  }\n  .epic-cta:hover { transform: translateY(-1px); }\n  /* The enterprise CTAs are links to the package-code redemption screen, not\n     form submits � an <a> is inline by default, so it needs to be told to\n     behave like the buttons it replaces (full-width pill, centred label). */\n  .epic-cta-link {\n    display: block;\n    color: inherit;\n    text-align: center;\n    text-decoration: none;\n  }\n  .epic-cta-pink {\n    color: var(--ink);\n    background: var(--sun);\n    box-shadow: 0 10px 20px rgba(248, 200, 75, .35);\n  }\n  .epic-cta-blue {\n    color: var(--white);\n    background: var(--lavender);\n    box-shadow: 0 10px 20px rgba(169, 150, 238, .35);\n  }\n  .epic-cta-individual {\n    color: #111111;\n    background: #ffd22e;\n    box-shadow: 0 10px 20px rgba(255, 210, 46, .38);\n  }\n  .epic-cta-family {\n    color: #111111;\n    background: #83a8f6;\n    box-shadow: 0 10px 20px rgba(131, 168, 246, .38);\n  }\n  .epic-cta-enterprise,\n  .epic-cta-green {\n    color: #111111;\n    background: #5bdad4;\n    box-shadow: 0 10px 20px rgba(91, 218, 212, .38);\n  }\n  .epic-cta-red {\n    color: #fff;\n    background: var(--danger);\n    box-shadow: 0 10px 20px rgba(217, 93, 93, .35);\n  }\n  .epic-enterprise-min {\n    width: 100%;\n    margin: 4px 0 0;\n    padding: 14px 12px;\n    border-radius: 14px;\n    color: var(--success);\n    background: var(--mint-soft);\n    font-size: 1.02rem;\n    font-weight: 800;\n    text-align: center;\n  }\n  .epic-skip { margin-top: 34px; }\n  .epic-skip button {\n    border: 0;\n    color: var(--ink);\n    background: none;\n    opacity: .8;\n    font-weight: 700;\n    text-decoration: underline;\n    cursor: pointer;\n  }\n  .subscription-field { width: 100%; text-align: left; }\n  .subscription-field-spaced { margin-top: 12px; }\n  .uppercase-field { text-transform: uppercase; }\n  .subscription-action-top { margin-top: 12px; }\n  .subscription-action-large { margin-top: 20px; }\n  .subscription-field-hint {\n    width: 100%;\n    margin: 14px 0 0;\n    color: var(--muted);\n    font-size: .9rem;\n    font-weight: 600;\n    line-height: 1.45;\n    text-align: left;\n  }\n  /* Opens the "Full school pricing details" calculator on the Enterprise card.\n     Kept compact so the three plan cards stay the same short height. */\n  .subscription-details-link {\n    margin-top: -2px;\n    padding: 0;\n    border: 0;\n    color: var(--auto-4338ca-t);\n    background: none;\n    font: inherit;\n    font-size: .86rem;\n    font-weight: 800;\n    line-height: 1.2;\n    text-decoration: underline;\n    cursor: pointer;\n  }\n  .subscription-details-link:hover { color: var(--auto-b8860b-t); }\n\n  /* \u2500\u2500 Enterprise pricing calculator \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n     Scoped to body:not(.diagram-body) like the rest of the dialog styles so\n     the ui-flow diagram page is unaffected. The dialog itself already caps its\n     height and scrolls (see .account-dialog), so the calculator only has to\n     flow sensibly from a single column on phones to two up on wide screens. */\n  body:not(.diagram-body) .enterprise-pricing-dialog {\n    width: min(680px, calc(100% - 32px));\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-calculator {\n    display: grid;\n    gap: 16px;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-calculator-fields {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 14px;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-field {\n    display: grid;\n    gap: 7px;\n    color: #27344c;\n    font-size: .92rem;\n    font-weight: 800;\n    text-align: left;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-field select,\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-field input {\n    width: 100%;\n    min-height: 48px;\n    padding: 10px 13px;\n    border: 1px solid #c9d3e4;\n    border-radius: 9px;\n    color: #17233a;\n    background: #fff;\n    font: inherit;\n    font-size: 1rem;\n    font-weight: 600;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-field input:focus-visible,\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-field select:focus-visible {\n    outline: 3px solid #5bdad4;\n    outline-offset: 1px;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-note {\n    color: #566176;\n    font-size: .88rem;\n    line-height: 1.55;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-validation {\n    margin: 0;\n    padding: 11px 14px;\n    border: 1px solid #e4b5ba;\n    border-radius: 10px;\n    color: #7d1f2a;\n    background: #fdf1f2;\n    font-size: .92rem;\n    font-weight: 700;\n    line-height: 1.5;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-result {\n    display: grid;\n    gap: 2px;\n    padding: 16px 18px;\n    border: 1px solid #d6eee7;\n    border-radius: 14px;\n    background: #f2fbf8;\n    /* Dimmed while a fresh quote is on its way, so stale figures for the\n       previous school type are never mistaken for the current answer. */\n    transition: opacity .12s ease;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-result[data-pricing-pending="true"] {\n    opacity: .45;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-result-row {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px 12px;\n    align-items: baseline;\n    justify-content: space-between;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-result-label {\n    color: #46625b;\n    font-size: .92rem;\n    font-weight: 700;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-result-value {\n    color: #123b32;\n    font-size: 1.3rem;\n    font-weight: 900;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-result-row-prepay {\n    margin-top: 8px;\n    padding-top: 8px;\n    border-top: 1px dashed #bfe3d9;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-breakdown {\n    margin: 10px 0 0;\n    color: #46625b;\n    font-size: .9rem;\n    font-weight: 700;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-breakdown-note {\n    margin: 4px 0 0;\n    color: #566176;\n    font-size: .86rem;\n    line-height: 1.5;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-table-wrap {\n    overflow-x: auto;\n    border: 1px solid #e2e8f2;\n    border-radius: 12px;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-table {\n    width: 100%;\n    min-width: 380px;\n    border-collapse: collapse;\n    font-size: .88rem;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-table caption {\n    padding: 12px 14px 0;\n    color: #566176;\n    font-size: .84rem;\n    font-weight: 700;\n    line-height: 1.5;\n    text-align: left;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-table th,\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-table td {\n    padding: 9px 14px;\n    text-align: left;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-table thead th {\n    border-bottom: 1px solid #e2e8f2;\n    color: #27344c;\n    font-weight: 800;\n    white-space: nowrap;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-table tbody tr + tr th,\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-table tbody tr + tr td {\n    border-top: 1px solid #eef2f8;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-table tbody th {\n    color: #27344c;\n    font-weight: 700;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-table tbody td {\n    color: #46625b;\n    font-weight: 700;\n    white-space: nowrap;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-table tbody tr.pricing-table-row-current {\n    background: #f2fbf8;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-plain {\n    display: grid;\n    gap: 8px;\n    color: #566176;\n  }\n  body:not(.diagram-body) .enterprise-pricing-dialog .pricing-plain p {\n    margin: 0;\n    font-size: .9rem;\n    line-height: 1.6;\n  }\n  @media (max-width: 560px) {\n    body:not(.diagram-body) .enterprise-pricing-dialog .pricing-calculator-fields {\n      grid-template-columns: minmax(0, 1fr);\n    }\n    body:not(.diagram-body) .enterprise-pricing-dialog .pricing-result-value {\n      font-size: 1.15rem;\n    }\n  }\n  .subscription-cancel-wrap { margin-top: 32px; text-align: center; }\n  /* Echoes back the quote a school built in the Enterprise pricing dialog, so\n     the package-code screen doesn\'t lose the figures it just calculated. */\n  .subscription-enquiry {\n    display: grid;\n    gap: 4px;\n    width: 100%;\n    margin-top: 16px;\n    padding: 14px 16px;\n    border: 1px solid #d6eee7;\n    border-radius: 14px;\n    color: #46625b;\n    background: #f2fbf8;\n    text-align: left;\n  }\n  .subscription-enquiry-heading {\n    margin: 0;\n    color: #123b32;\n    font-size: .84rem;\n    font-weight: 900;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n  }\n  .subscription-enquiry-line { margin: 0; font-size: .92rem; font-weight: 700; line-height: 1.5; }\n  .subscription-enquiry-total { color: #123b32; }\n\n  /* \u2500\u2500 Enterprise school finder \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n     Province + school search with autocomplete, shared by the pricing dialog\n     and /subscription/redeem-package so both look and behave identically. */\n  .school-finder {\n    display: grid;\n    gap: 14px;\n    width: 100%;\n    text-align: left;\n  }\n  .school-finder .sf-combobox {\n    position: relative;\n  }\n  .school-finder [data-sf-suggestions] {\n    position: absolute;\n    z-index: 5;\n    top: calc(100% + 4px);\n    right: 0;\n    left: 0;\n    max-height: 260px;\n    margin: 0;\n    padding: 4px;\n    overflow-y: auto;\n    list-style: none;\n    border: 1px solid #c9d3e4;\n    border-radius: 10px;\n    background: #fff;\n    box-shadow: 0 12px 28px rgba(36, 48, 68, .18);\n  }\n  .school-finder [data-sf-suggestions][hidden] { display: none; }\n  .school-finder .sf-suggestion {\n    display: grid;\n    gap: 2px;\n    padding: 9px 11px;\n    border-radius: 7px;\n    cursor: pointer;\n  }\n  .school-finder .sf-suggestion.is-active,\n  .school-finder .sf-suggestion:hover {\n    background: #eef4ff;\n  }\n  .school-finder .sf-suggestion-name {\n    color: #17233a;\n    font-size: .95rem;\n    font-weight: 800;\n    line-height: 1.3;\n  }\n  /* Town and district, so two schools sharing a name are told apart. */\n  .school-finder .sf-suggestion-place {\n    color: #566176;\n    font-size: .84rem;\n    font-weight: 600;\n  }\n  .school-finder .sf-suggestion-quintile {\n    color: #176f5d;\n    font-size: .78rem;\n    font-weight: 800;\n  }\n  .school-finder .sf-suggestion-status,\n  .school-finder .sf-suggestion-empty {\n    color: #566176;\n    font-size: .88rem;\n    font-weight: 700;\n    cursor: default;\n  }\n  .school-finder .sf-suggestion-status:hover,\n  .school-finder .sf-suggestion-empty:hover { background: none; }\n  .school-finder .sf-status {\n    margin: 0;\n    color: #566176;\n    font-size: .86rem;\n    font-weight: 700;\n    line-height: 1.5;\n  }\n  .school-finder .sf-status[hidden] { display: none; }\n  .school-finder .sf-selected {\n    gap: 4px;\n  }\n  .school-finder .sf-selected-name {\n    margin: 0;\n    color: #123b32;\n    font-size: 1.02rem;\n    font-weight: 900;\n    line-height: 1.35;\n  }\n  .school-finder .sf-selected-meta {\n    margin: 0;\n    color: #46625b;\n    font-size: .84rem;\n    font-weight: 700;\n  }\n  .school-finder .sf-selected-note {\n    margin: 4px 0 0;\n    color: #566176;\n    font-size: .86rem;\n    font-weight: 600;\n    line-height: 1.5;\n  }\n  .school-finder .sf-selected-price {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 4px 12px;\n    align-items: baseline;\n    justify-content: space-between;\n    margin: 10px 0 0;\n    padding-top: 10px;\n    border-top: 1px dashed #bfe3d9;\n  }\n  .school-finder .sf-selected-price span {\n    color: #46625b;\n    font-size: .92rem;\n    font-weight: 700;\n  }\n  .school-finder .sf-selected-price strong {\n    color: #123b32;\n    font-size: 1.3rem;\n    font-weight: 900;\n  }\n  .school-finder .sf-manual[hidden] { display: none; }\n  .school-finder .sf-manual-prompt { margin: 0; }\n  .school-finder .sf-manual-toggle {\n    padding: 0;\n    border: 0;\n    color: var(--auto-4338ca-t);\n    background: none;\n    font: inherit;\n    font-size: .9rem;\n    font-weight: 800;\n    line-height: 1.4;\n    text-decoration: underline;\n    cursor: pointer;\n  }\n  .school-finder .sf-manual-toggle:hover { color: var(--auto-b8860b-t); }\n  .school-finder .sf-manual-toggle:focus-visible {\n    outline: 3px solid #5bdad4;\n    outline-offset: 2px;\n  }\n  .school-finder .sf-not-sure {\n    display: flex;\n    gap: 9px;\n    align-items: start;\n    margin-top: 10px;\n    color: #566176;\n    font-size: .84rem;\n    font-weight: 600;\n    line-height: 1.45;\n    cursor: pointer;\n  }\n  .school-finder .sf-not-sure input {\n    width: 17px;\n    height: 17px;\n    margin: 1px 0 0;\n    flex: 0 0 auto;\n    accent-color: #176f5d;\n  }\n  .school-finder .sf-footnote {\n    margin: 0;\n    padding-top: 10px;\n    border-top: 1px solid #e2e8f2;\n    color: #6b7486;\n    font-size: .78rem;\n    font-weight: 600;\n    line-height: 1.5;\n  }\n  .subscription-cancel-link { display: inline-block; width: auto; padding: 12px 24px; }\n  .subscription-note { margin-top: 18px; text-align: center; }\n  .subscription-teacher-hero { position: relative; overflow: visible; }\n  .subscription-tier-cards { max-width: 1000px; margin: 28px auto; }\n  .subscription-tier-card { width: 290px; }\n  .subscription-tier-badge { margin-bottom: 8px; }\n  .subscription-tier-description { margin-bottom: 18px; }\n  .subscription-instructions { margin-top: 6px; text-align: center; }\n  .subscription-activation-cards { margin: 24px auto; }\n  .subscription-activation-card { width: 380px; }\n  .subscription-activation-description { margin-bottom: 22px; }\n  .subscription-status { font-weight: 800; }\n  .subscription-cancel-copy { margin-top: 1rem; color: var(--muted); }\n  .subscription-cancel-button {\n    margin-top: 1.2rem;\n    border: 0;\n    color: var(--white);\n    background: #d64545;\n    box-shadow: 0 8px 20px rgba(214, 69, 69, .22);\n  }\n  .subscription-back-link { margin-top: .8rem; }\n  .payment-security-note { margin-top: 1rem; color: var(--muted); font-size: .9rem; }\n  .payment-tabs { margin-bottom: 1.2rem; }\n  .payment-submit { margin-top: 1.2rem; }\n\n  @media (max-width: 720px) {\n    .epic-cards { flex-direction: column; align-items: center; }\n    .epic-card { width: 100%; max-width: 340px; }\n  }\n}\n\n/* State utilities intentionally sit above component layers. */\n.hidden { display: none; }\n.is-hidden { display: none; }\n\n/* \u2500\u2500\u2500 Trial-expired "payment due" screen \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.payment-due-overlay {\n  min-height: 60vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 2rem 1rem;\n}\n\n.payment-due-modal {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  box-shadow: 0 12px 32px rgba(36, 48, 68, .12);\n  max-width: 480px;\n  width: 100%;\n  padding: 2.4rem 2rem;\n  text-align: center;\n}\n\n.payment-due-koaly {\n  width: 72px;\n  height: auto;\n  margin: 0 auto 1rem;\n}\n\n.payment-due-modal h1 {\n  font-size: 1.5rem;\n  margin-bottom: .8rem;\n  color: var(--ink);\n}\n\n.payment-due-modal p {\n  color: var(--muted);\n  line-height: 1.5;\n  margin-bottom: .6rem;\n}\n\n.payment-due-sub {\n  font-size: .92rem;\n}\n\n.payment-due-actions {\n  display: flex;\n  gap: .8rem;\n  justify-content: center;\n  margin-top: 1.4rem;\n  flex-wrap: wrap;\n}\n\n/* \u2500\u2500\u2500 Kid-friendly trial-expired visual (learner view) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.trial-kid-visual {\n  position: relative;\n  width: 140px;\n  margin: 0 auto 1.2rem;\n}\n\n.trial-kid-koaly {\n  width: 140px;\n  margin: 0;\n  filter: grayscale(.15);\n}\n\n.trial-kid-stop {\n  position: absolute;\n  bottom: -6px;\n  right: -14px;\n  width: 56px;\n  height: 56px;\n  border-radius: 50%;\n  background: #e6453f;\n  border: 5px solid var(--white);\n  box-shadow: 0 6px 14px rgba(230, 69, 63, .35);\n}\n\n.trial-kid-stop::after {\n  content: \'\';\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 34px;\n  height: 6px;\n  background: var(--surface);\n  border-radius: 3px;\n  transform: translate(-50%, -50%) rotate(-45deg);\n}\n\n.trial-kid-headline {\n  font-size: 2.4rem;\n  margin-bottom: .6rem;\n  color: #e6453f;\n}\n\n.trial-kid-message {\n  font-size: 1.1rem;\n  font-weight: 600;\n  color: var(--ink);\n  margin-bottom: 0;\n}\n\n/* ---- Dark mode ---- */\n[d