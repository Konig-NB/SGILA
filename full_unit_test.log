fy-content: space-between;\n  text-align: left;\n  padding: 10px 12px;\n  border-radius: 18px;\n  background: var(--auto-f8fbff-bg);\n}\n\nbody:not(.diagram-body) .needs-help {\n  border-color: rgba(255, 90, 102, .38);\n  background: rgba(var(--auto-rgb-255-228-240), .82);\n}\n\n.mobile-bottom-nav {\n  position: fixed;\n  left: 50%;\n  bottom: 14px;\n  z-index: 20;\n  width: min(398px, calc(100% - 28px));\n  transform: translateX(-50%);\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 8px;\n  padding: 10px;\n  border: 1px solid rgba(217, 224, 238, .9);\n  border-radius: 30px;\n  background: rgba(37, 41, 65, .96);\n  box-shadow: 0 18px 42px rgba(20, 33, 61, .22);\n}\n\n.mobile-bottom-nav a {\n  display: grid;\n  justify-items: center;\n  gap: 5px;\n  color: var(--white);\n  text-decoration: none;\n  font-size: .68rem;\n  font-weight: 900;\n}\n\n.mobile-bottom-nav span {\n  display: grid;\n  place-items: center;\n  width: 34px;\n  height: 34px;\n  border-radius: 50%;\n  background: #3c435b;\n  color: var(--white);\n}\n\n.mobile-bottom-nav a:nth-child(1) span {\n  background: #ffd22e;\n  color: var(--auto-14213d-t);\n}\n\n.mobile-bottom-nav a:nth-child(2) span {\n  background: #5bdad4;\n  color: var(--auto-14213d-t);\n}\n\n.mobile-bottom-nav a:nth-child(3) span {\n  background: #83a8f6;\n}\n\n.mobile-bottom-nav a:nth-child(4) span {\n  background: #a37cf3;\n}\n\n@media (max-width: 760px) {\n  .navbar { align-items: flex-start; }\n  .nav-links { font-size: .9rem; gap: 6px; }\n  .hero, .auth-layout, .dashboard-hero { grid-template-columns: 1fr; }\n  .hero { min-height: auto; }\n  .quick-roles, .result-grid { grid-template-columns: 1fr; }\n  .two-col { grid-template-columns: 1fr; }\n  .lesson-card { grid-template-columns: 1fr; }\n  .learner-row, .pronunciation-card { grid-template-columns: 1fr; }\n  .row-stat { text-align: left; }\n  .diagram-header { align-items: start; flex-direction: column; }\n  .hero-copy h1, .auth-intro h1, .dashboard-hero h1, .activity-shell h1, .result-screen h1 {\n    font-size: clamp(2rem, 14vw, 3.5rem);\n  }\n}\n\n/* Web application reset: keep the new SGILA visuals without the phone-shell layout. */\nbody:not(.diagram-body) .navbar {\n  width: 100%;\n  margin: 0;\n  padding: 14px clamp(18px, 4vw, 54px);\n  border-radius: 0;\n  border-left: 0;\n  border-right: 0;\n}\n\nbody:not(.diagram-body) .nav-links {\n  max-width: none;\n  overflow: visible;\n  flex-wrap: wrap;\n}\n\n.mobile-bottom-nav {\n  display: none;\n}\n\nbody:not(.diagram-body) .hero,\nbody:not(.diagram-body) .dashboard-hero,\nbody:not(.diagram-body) .activity-shell,\nbody:not(.diagram-body) .result-screen,\nbody:not(.diagram-body) .form-card,\nbody:not(.diagram-body) .auth-intro {\n  box-shadow: 0 18px 44px rgba(36, 48, 68, .09);\n}\n\nbody:not(.diagram-body) .hero {\n  padding: clamp(28px, 5vw, 48px);\n}\n\nbody:not(.diagram-body) .hero-mascot {\n  min-height: 430px;\n}\n\n.phone-preview-card {\n  width: min(360px, 100%);\n}\n\n.story-image img,\n.picture-placeholder img {\n  width: 100%;\n  max-height: 390px;\n  object-fit: contain;\n  border-radius: 18px;\n}\n\n.lesson-cover img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  border-radius: inherit;\n}\n\n.pronunciation-image {\n  width: 72px;\n  height: 72px;\n  object-fit: contain;\n  justify-self: center;\n}\n\n.reactive-koaly {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  width: min(560px, 100%);\n  margin: 18px auto;\n  padding: 14px 18px;\n  border-radius: 24px;\n  border: 1px solid rgba(217, 224, 238, .9);\n  background: rgba(var(--surface-rgb), .92);\n  box-shadow: 0 14px 30px rgba(36, 48, 68, .08);\n}\n\n.reactive-koaly img {\n  width: 72px;\n  height: 72px;\n  object-fit: contain;\n  transition: transform .25s ease;\n}\n\n.reactive-koaly strong,\n.reactive-koaly span {\n  display: block;\n}\n\n.reactive-koaly span {\n  margin-top: 3px;\n  color: var(--muted);\n  font-weight: 700;\n}\n\n.koaly-listening img {\n  transform: rotate(-5deg)