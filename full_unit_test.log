-empty,\n  .chat-bubble-time,\n  .conv-other-label,\n  .conv-preview--empty,\n  .conv-time,\n  .terms-footer-note,\n  .password-requirements li:not(.met),\n  .gc-banner-head p,\n  .gc-confirm-current,\n  .gc-confirm-label,\n  .pronunciation-translation,\n  .drag-match-slot\n) {\n  color: #ffffff;\n}\n\n[data-theme="dark"] body {\n  background: radial-gradient(circle at 14% 8%, rgba(110, 224, 194, .14), transparent 32%),\n    radial-gradient(circle at 88% 12%, rgba(150, 210, 230, .10), transparent 26%),\n    linear-gradient(160deg, #1c4258 0%, #17394a 45%, #123f42 100%);\n  background-attachment: fixed;\n}\n\n[data-theme="dark"] .navbar {\n  background: rgba(22, 50, 63, .92);\n}\n\n[data-theme="dark"] img {\n  opacity: .95;\n}\n\n/* Reading Studio homepage */\nbody.home-page {\n  --studio-surface: #ffffff;\n  --studio-surface-rgb: 255, 255, 255;\n  --studio-library: #f7fafc;\n  --studio-ink: #10224a;\n  --studio-muted: #5e6a7d;\n  --studio-line: #e7ebf0;\n  --studio-shadow-rgb: 20, 36, 64;\n  --studio-nav-rgb: 255, 255, 255;\n  --studio-action-ink: #14213d;\n  background: var(--studio-surface);\n}\n\n[data-theme="dark"] body.home-page {\n  --studio-surface: #203a44;\n  --studio-surface-rgb: 32, 58, 68;\n  --studio-library: #16323f;\n  --studio-ink: #f4f7ff;\n  --studio-muted: #b7c7d3;\n  --studio-line: #3e5966;\n  --studio-shadow-rgb: 3, 19, 29;\n  --studio-nav-rgb: 17, 39, 51;\n}\n\nbody.home-page .app-navbar {\n  min-height: 76px;\n  padding: 12px clamp(20px, 4vw, 68px);\n  border-bottom: 1px solid var(--studio-line);\n  background: rgba(var(--studio-nav-rgb), .97);\n  box-shadow: 0 4px 18px rgba(var(--studio-shadow-rgb), .12);\n}\n\nbody.home-page .nav-brand {\n  color: var(--studio-ink);\n  font-size: 1.45rem;\n  letter-spacing: .04em;\n}\n\nbody.home-page .brand-mark {\n  width: 48px;\n  height: 48px;\n  background: transparent;\n}\n\nbody.home-page .brand-mark img {\n  width: 48px;\n  height: 48px;\n  object-fit: contain;\n}\n\n.home-nav-links {\n  display: flex;\n  align-items: center;\n  gap: clamp(24px, 4vw, 52px);\n  margin-left: auto;\n  margin-right: auto;\n  font-weight: 750;\n}\n\n.home-nav-links a {\n  color: var(--studio-ink);\n  text-decoration: none;\n}\n\n.home-nav-links a:hover {\n  color: #e65347;\n}\n\nbody.home-page .nav-links a {\n  border-radius: 6px;\n}\n\nbody.home-page .nav-links .nav-cta {\n  min-width: 92px;\n  padding: 12px 22px;\n  text-align: center;\n  color: var(--studio-action-ink);\n  background: var(--sun);\n}\n\n.not-found {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(260px, 420px);\n  align-items: center;\n  gap: clamp(32px, 8vw, 96px);\n  min-height: calc(100vh - 110px);\n  padding: clamp(40px, 8vw, 100px) clamp(24px, 8vw, 110px);\n  background: var(--surface);\n}\n\n.not-found-copy {\n  max-width: 620px;\n}\n\n.not-found-kicker {\n  margin: 0 0 16px;\n  color: var(--danger);\n  font-size: .85rem;\n  font-weight: 850;\n  letter-spacing: .12em;\n}\n\n.not-found h1 {\n  max-width: 600px;\n  margin: 0;\n  color: var(--ink);\n  font-size: clamp(2.5rem, 5vw, 5rem);\n  line-height: 1;\n}\n\n.not-found-copy > p:not(.not-found-kicker) {\n  max-width: 520px;\n  margin: 24px 0 30px;\n  color: var(--muted);\n  font-size: 1.1rem;\n  line-height: 1.6;\n}\n\n.not-found-button {\n  display: inline-flex;\n  min-height: 50px;\n  align-items: center;\n  padding: 13px 22px;\n  border-radius: 6px;\n  color: var(--ink);\n  background: var(--sun);\n  font-weight: 800;\n  text-decoration: none;\n}\n\n.not-found-button:hover {\n  background: var(--sun-soft);\n}\n\n.not-found-art {\n  position: relative;\n  display: grid;\n  min-height: 300px;\n  place-items: center;\n  border: 1px solid var(--line);\n  border-radius: 18px;\n  background: linear-gradient(145deg, var(--sun-soft), var(--mint-soft));\n  overflow: hidden;\n}\n\n.not-found-number {\n  color: var(--ink);\n  font-size: clamp(5rem, 13vw, 9rem);\n  font-weight: 900;\n  line-height: 1;\n  opacity: .18;\n}\n\n.not-found-art img {\n  position: absolute;\n  right: 12%;\n  bottom: 7%;\n  width: min(42%, 170px);\n  height: auto;\n}\n\n@media (max-width: 760px) {\n  .not-found {\n    grid-template-columns: 1fr;\n    min-height: auto;\n    padding-block: 56px 72px;\n  }\n\n  .not-found-art {\n    min-height: 220px;\n  }\n}\n\n@layer pages {\n  body.home-page .main-content {\n    width: 100%;\n    max-width: none;\n    margin: 0;\n    padding: 0;\n  }\n}\n\n.studio-home {\n  color: var(--studio-ink);\n  background: var(--studio-surface);\n}\n\n.studio-hero {\n  display: grid;\n  grid-template-columns: minmax(360px, 39%) minmax(0, 61%);\n  min-height: 620px;\n  border-bottom: 1px solid var(--studio-line);\n  background: var(--studio-surface);\n}\n\n.studio-hero-copy {\n  z-index: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: clamp(32px, 3vw, 44px) clamp(32px, 5vw, 82px);\n  box-shadow: 28px 0 44px rgba(var(--studio-surface-rgb), .74);\n}\n\n.studio-kicker,\n.studio-section-kicker {\n  margin: 0 0 16px;\n  color: #e65347;\n  font-size: .85rem;\n  font-weight: 850;\n  letter-spacing: .12em;\n}\n\n.studio-kicker {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: .35rem;\n}\n\n.studio-kicker-read {\n  color: #ffd22e;\n}\n\n.studio-kicker-listen {\n  color: #83a8f6;\n}\n\n.studio-kicker-understand {\n  color: #5bdad4;\n}\n\n.studio-kicker-slash {\n  color: #14213d;\n}\n\n[data-theme="dark"] .studio-kicker-slash {\n  padding-inline: 0;\n  border-radius: 0;\n  background: transparent;\n  color: var(--studio-muted);\n}\n\n.studio-hero h1 {\n  max-width: 590px;\n  margin: 0;\n  color: var(--studio-ink);\n  font-size: clamp(3rem, 4.8vw, 5.4rem);\n  line-height: .98;\n  letter-spacing: 0;\n}\n\n.studio-tagline {\n  max-width: 560px;\n  margin: 20px 0 0;\n  color: var(--studio-ink);\n  font-size: clamp(1.4rem, 2vw, 2rem);\n  font-weight: 750;\n  line-height: 1.2;\n}\n\n.studio-support {\n  margin: 10px 0 0;\n  color: var(--studio-muted);\n  font-size: 1.08rem;\n}\n\n.studio-hero-actions {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 24px;\n  margin-top: 30px;\n}\n\n.studio-button {\n  display: inline-flex;\n  min-height: 52px;\n  align-items: center;\n  justify-content: center;\n  padding: 14px 24px;\n  border-radius: 6px;\n  text-decoration: none;\n  font-weight: 800;\n}\n\n.studio-button-primary {\n  min-width: 172px;\n  color: var(--studio-action-ink);\n  background: var(--sun);\n  box-shadow: 0 10px 22px rgba(255, 203, 41, .28);\n}\n\n.studio-button-primary:hover {\n  background: #ffdc63;\n  transform: translateY(-1px);\n}\n\n.studio-text-link {\n  color: var(--studio-ink);\n  font-weight: 800;\n  text-decoration-thickness: 2px;\n  text-underline-offset: 5px;\n}\n\n.studio-role-selector {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 10px;\n  width: min(100%, 500px);\n  margin-top: 34px;\n}\n\n.studio-role {\n  display: flex;\n  min-height: 66px;\n  align-items: center;\n  justify-content: center;\n  padding: 12px;\n  border-radius: 8px;\n  color: var(--studio-action-ink);\n  text-decoration: none;\n  font-weight: 800;\n}\n\n.studio-role:hover,\n.studio-role.is-active {\n  filter: brightness(1.04);\n}\n\n.studio-role:focus-visible {\n  outline: 3px solid var(--studio-ink);\n  outline-offset: 3px;\n}\n\n.studio-role-learner {\n  color: var(--studio-action-ink);\n  background: #ffd22e;\n}\n\n.studio-role-parent-option {\n  color: #14213d;\n  background: #83a8f6;\n}\n\n.studio-role-teacher-option {\n  color: #14213d;\n  background: #5bdad4;\n}\n\n.studio-hero-media {\n  position: relative;\n  min-width: 0;\n  overflow: hidden;\n  background: var(--mint-soft);\n}\n\n.studio-hero-media img {\n  width: 100%;\n  height: 100%;\n  min-height: 620px;\n  display: block;\n  object-fit: cover;\n  object-position: center;\n}\n\n.studio-stories {\n  padding: 34px clamp(24px, 4vw, 72px) 58px;\n  background: var(--studio-library);\n}\n\n.studio-section-heading {\n  display: flex;\n  align-items: end;\n  justify-content: space-between;\n  gap: 20px;\n  margin-bottom: 22px;\n}\n\n.studio-section-kicker {\n  margin-bottom: 7px;\n  color: #1599a7;\n}\n\n.studio-section-heading h2 {\n  margin: 0;\n  color: var(--studio-ink);\n  font-size: clamp(1.9rem, 3vw, 2.7rem);\n  letter-spacing: 0;\n}\n\n.studio-story-grid {\n  display: grid;\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n  gap: clamp(12px, 1.6vw, 24px);\n}\n\n.studio-story-card {\n  min-width: 0;\n  border: 1px solid var(--studio-line);\n  border-radius: 8px;\n  color: var(--studio-ink);\n  background: var(--studio-surface);\n  box-shadow: 0 10px 24px rgba(var(--studio-shadow-rgb), .16);\n  text-decoration: none;\n  overflow: hidden;\n  transition: transform .18s ease, box-shadow .18s ease;\n}\n\n.studio-story-card:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 16px 30px rgba(var(--studio-shadow-rgb), .23);\n}\n\n.studio-story-image {\n  position: relative;\n  aspect-ratio: 1;\n  overflow: hidden;\n  background: var(--studio-line);\n}\n\n.studio-story-image img {\n  width: 100%;\n  height: 100%;\n  display: block;\n  object-fit: cover;\n  object-position: center;\n}\n\n.studio-grade {\n  position: absolute;\n  top: 14px;\n  left: 14px;\n  padding: 7px 10px;\n  border-radius: 5px;\n  color: #ffffff;\n  background: #1599a7;\n  font-size: .78rem;\n  font-weight: 850;\n}\n\n.studio-grade-two {\n  background: #2f6fd0;\n}\n\n.studio-grade-four {\n  background: #7f67d9;\n}\n\n.studio-story-meta {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  min-height: 84px;\n  padding: 18px 20px;\n}\n\n.studio-story-meta h3 {\n  min-width: 0;\n  margin: 0;\n  color: var(--studio-ink);\n  font-size: 1.1rem;\n  letter-spacing: 0;\n}\n\n.studio-story-meta span {\n  flex: 0 0 auto;\n  color: var(--studio-muted);\n  font-size: .82rem;\n  font-weight: 700;\n}\n\n@media (max-width: 1050px) {\n  .home-nav-links {\n    display: none;\n  }\n\n  .studio-hero {\n    grid-template-columns: minmax(330px, 46%) minmax(0, 54%);\n  }\n\n  .studio-hero-copy {\n    padding-inline: 30px;\n  }\n\n  .studio-story-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n\n  .studio-story-meta {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 6px;\n  }\n}\n\n@media (max-width: 760px) {\n  body.home-page .app-navbar {\n    min-height: 64px;\n    padding: 8px 16px;\n  }\n\n  body.home-page .brand-mark,\n  body.home-page .brand-mark img {\n    width: 40px;\n    height: 40px;\n  }\n\n  body.home-page .nav-brand {\n    font-size: 1.15rem;\n  }\n\n  body.home-page .nav-links {\n    flex-wrap: nowrap;\n    gap: 4px;\n  }\n\n  body.home-page .nav-links > span,\n  body.home-page .nav-links > a[href="/conversations"],\n  body.home-page .nav-links > a[href="/parent/add-child"],\n  body.home-page .nav-links > a[href="/subscription"] {\n    display: none;\n  }\n\n  body.home-page .nav-links a {\n    padding: 8px;\n    font-size: .84rem;\n  }\n\n  body.home-page .nav-links .nav-cta {\n    min-width: 62px;\n    padding: 9px 12px;\n  }\n\n  .studio-hero {\n    display: flex;\n    min-height: auto;\n    flex-direction: column;\n  }\n\n  .studio-hero-copy {\n    order: 1;\n    padding: 30px 20px 24px;\n    box-shadow: none;\n  }\n\n  .studio-hero h1 {\n    font-size: clamp(2.5rem, 12vw, 3.5rem);\n  }\n\n  .studio-tagline {\n    margin-top: 14px;\n    font-size: 1.35rem;\n  }\n\n  .studio-support {\n    font-size: .96rem;\n  }\n\n  .studio-hero-actions {\n    gap: 16px;\n    margin-top: 22px;\n  }\n\n  .studio-button {\n    min-height: 48px;\n    padding: 12px 18px;\n  }\n\n  .studio-role-selector {\n    margin-top: 24px;\n  }\n\n  .studio-role {\n    min-height: 56px;\n    padding: 9px 6px;\n    font-size: .82rem;\n  }\n\n  .studio-hero-media {\n    order: 2;\n    height: 230px;\n  }\n\n  .studio-hero-media img {\n    min-height: 230px;\n    object-position: center 48%;\n  }\n\n  .studio-stories {\n    padding: 26px 18px 42px;\n  }\n\n  .studio-section-heading {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .studio-story-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 16px;\n  }\n\n  .studio-story-meta {\n    align-items: center;\n    flex-direction: row;\n  }\n}\n\n@media (max-width: 500px) {\n  .studio-story-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .studio-story-card,\n  .studio-button-primary {\n    transition: none;\n  }\n}\n\n/* Grade 1 integrated visual activity journey. */\nbody:not(.diagram-body) .activity-media {\n  display: grid;\n  grid-template-columns: minmax(180px, 280px) minmax(0, 1fr);\n  align-items: center;\n  gap: 22px;\n  margin-bottom: 22px;\n  padding: 16px;\n  border: 1px solid #d8dee8;\n  border-radius: 8px;\n  background: #f8fbff;\n}\n\nbody:not(.diagram-body) .activity-media-copy {\n  display: grid;\n  justify-items: start;\n  gap: 8px;\n}\n\nbody:not(.diagram-body) .activity-media.audio-only {\n  grid-template-columns: 1fr;\n  width: max-content;\n  max-width: 100%;\n  padding: 8px;\n  border: 0;\n  background: transparent;\n}\n\nbody:not(.diagram-body) .activity-listen {\n  min-width: 132px;\n}\n\nbody:not(.diagram-body) .activity-media.grade1-phonics-media {\n  grid-template-columns: minmax(220px, 320px) minmax(260px, 1fr);\n  gap: 32px;\n  padding: 24px;\n}\n\nbody:not(.diagram-body) .grade1-phonics-media .activity-media-copy {\n  min-width: 0;\n  justify-items: center;\n  align-content: center;\n  gap: 24px;\n}\n\nbody:not(.diagram-body) .grade1-phonics-word {\n  display: block;\n  max-width: 100%;\n  color: #15233d;\n  font-size: 4.5rem;\n  font-weight: 900;\n  line-height: 1.05;\n  letter-spacing: 0;\n  overflow-wrap: anywhere;\n  text-align: center;\n  white-space: pre-wrap;\n}\n\nbody:not(.diagram-body) .grade1-phonics-blank {\n  display: inline-grid;\n  min-width: .72em;\n  min-height: .92em;\n  place-items: center;\n  border-bottom: