3c3489-t: #3c3489;\n  --auto-6d28d9-t: #6d28d9;\n  --auto-c4b5fd-bd: #c4b5fd;\n  --auto-f9fafb-bg: #f9fafb;\n  --auto-e0e7ff-bg: #e0e7ff;\n  --auto-3730a3-t: #3730a3;\n  --auto-d1d5db-bd: #d1d5db;\n  --auto-faf8ff-bg: #faf8ff;\n  --auto-ddd6fe-bg: #ddd6fe;\n  --auto-374151-t: #374151;\n  --auto-f8f8ff-bg: #f8f8ff;\n  --auto-555555-t: #555555;\n  --auto-1d4ed8-t: #1d4ed8;\n  --auto-111111-t: #111111;\n  --auto-16a34a-t: #16a34a;\n  --auto-ea580c-t: #ea580c;\n  --auto-dcfce7-bg: #dcfce7;\n  --auto-166534-t: #166534;\n  --auto-9a3412-t: #9a3412;\n  --auto-e5e7eb-bg: #e5e7eb;\n  --auto-22c55e-t: #22c55e;\n  --auto-f59e0b-t: #f59e0b;\n  --auto-f0eeff-bg: #f0eeff;\n  --auto-e0f2fe-bg: #e0f2fe;\n  --auto-dbeafe-bg: #dbeafe;\n  --auto-bfdbfe-bd: #bfdbfe;\n  --auto-1e3a5f-t: #1e3a5f;\n  --auto-64748b-t: #64748b;\n  --auto-e0f2fe-bd: #e0f2fe;\n  --auto-1e40af-t: #1e40af;\n  --auto-666666-t: #666666;\n  --auto-c0392b-t: #c0392b;\n  --auto-ffe68a-bd: #ffe68a;\n  --auto-9cbbff-bd: #9cbbff;\n  --auto-94fef5-bd: #94fef5;\n  --auto-b45309-t: #b45309;\n  --auto-15803d-t: #15803d;\n  --auto-fde68a-bd: #fde68a;\n  --auto-fffbeb-bg: #fffbeb;\n  --auto-2563eb-t: #2563eb;\n  --auto-c7d2fe-bd: #c7d2fe;\n  --auto-4338ca-t: #4338ca;\n  --auto-bbf7d0-bd: #bbf7d0;\n  --auto-b8860b-t: #b8860b;\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  font-family: "Segoe UI", Arial, sans-serif;\n  color: var(--ink);\n  background: radial-gradient(circle at 14% 8%, rgba(110, 224, 194, .24), transparent 28%),\n    radial-gradient(circle at 88% 10%, rgba(var(--auto-rgb-169-150-238), .22), transparent 24%),\n    var(--paper);\n}\n\na { color: inherit; }\n\n.navbar {\n  position: sticky;\n  top: 0;\n  z-index: 10;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 14px clamp(18px, 4vw, 54px);\n  background: rgba(var(--auto-rgb-255-253-245), .92);\n  border-bottom: 1px solid var(--line);\n  backdrop-filter: blur(12px);\n}\n\n.nav-brand {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  text-decoration: none;\n  font-weight: 900;\n  letter-spacing: .08em;\n}\n\n.brand-mark {\n  display: grid;\n  width: 34px;\n  height: 34px;\n  place-items: center;\n  border-radius: 50%;\n  background: var(--sun);\n  color: var(--ink);\n}\n\n.nav-links {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 12px;\n  color: var(--muted);\n  font-weight: 700;\n}\n\n.nav-links span {\n  color: var(--danger);\n  font-weight: 800;\n}\n\n.nav-links a {\n  text-decoration: none;\n  padding: 8px 10px;\n  border-radius: 999px;\n}\n\n.nav-links a:hover, .nav-cta { background: var(--sun-soft); color: var(--ink); }\n\n.theme-toggle {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 14px;\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  background: var(--paper);\n  color: var(--ink);\n  font-weight: 700;\n  font-size: .85rem;\n  font-family: inherit;\n  cursor: pointer;\n  transition: background .15s ease, border-color .15s ease;\n}\n\n.theme-toggle:hover {\n  background: var(--sun-soft);\n}\n\n.theme-toggle-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 16px;\n  height: 16px;\n  color: var(--sun);\n  font-size: 1rem;\n  line-height: 1;\n}\n\n.theme-toggle-icon::before {\n  content: "\\263D";\n}\n\n[data-theme="dark"] .theme-toggle-icon {\n  color: var(--lavender);\n}\n\n[data-theme="dark"] .theme-toggle-icon::before {\n  content: "\\2600";\n}\n\n@media (max-width: 640px) {\n  .theme-toggle-label { display: none; }\n}\n\n.main-content {\n  width: min(1120px, 100%);\n  margin: 0 auto;\n  padding: clamp(20px, 4vw, 48px);\n}\n\n.alerts { margin-bottom: 18px; }\n.alert { padding: 12px 16px; border-radius: 12px; background: var(--sun-soft); font-weight: 700; }\n.alert-error { color: var(--danger); background: var(--auto-ffe5e5-bg); }\n.alert-success { color: var(--success); background: var(--mint-soft); }\n\n.hero, .auth-layout, .dashboard-hero {\n  display: grid;\n  grid-template-columns: minmax(0, 1.2fr) minmax(240px, .8fr);\n  gap: clamp(24px, 5vw, 64px);\n  align-items: center;\n}\n\n.hero { min-height: 62vh; }\n.hero h1, .auth-intro h1, .dashboard-hero h1, .activity-shell h1, .result-screen h1 {\n  margin: 0;\n  font-size: clamp(2.2rem, 6vw, 5rem);\n  line-height: .95;\n}\n\n.hero p, .auth-intro p, .dashboard-hero p, .result-screen p {\n  color: var(--muted);\n  font-size: 1.08rem;\n}\n\n.eyebrow {\n  margin: 0 0 10px;\n  color: var(--success);\n  font-size: .78rem;\n  font-weight: 900;\n  letter-spacing: .14em;\n  text-transform: uppercase;\n}\n\n.hero-mascot {\n  min-height: 320px;\n  display: grid;\n  place-items: center;\n  border-radius: 36px;\n  background: linear-gradient(145deg, var(--mint-soft), var(--lavender-soft));\n}\n\n.hero-mascot img, .learner-hero img {\n  max-width: min(280px, 72vw);\n  width: 100%;\n  filter: drop-shadow(0 24px 34px rgba(36, 48, 68, .18));\n}\n\n.action-row, .tabs {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 24px;\n}\n\n.btn {\n  display: inline-flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 44px;\n  padding: 12px 20px;\n  border: 0;\n  border-radius: 999px;\n  font-weight: 900;\n  text-decoration: none;\n  cursor: pointer;\n  transition: transform .16s ease, box-shadow .16s ease;\n}\n\n.btn:hover { transform: translateY(-1px); box-shadow: 0 10px 24px rgba(36, 48, 68, .12); }\n.btn-primary { background: var(--sun); color: var(--ink); }\n.btn-mint { background: var(--mint); color: var(--ink); }\n.btn-light { background: var(--surface); color: var(--ink); border: 1px solid var(--line); }\n.btn-full { width: 100%; }\n.btn-large { min-height: 54px; padding-inline: 30px; }\n\n.quick-roles {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 14px;\n  justify-items: start;\n  justify-self: start;\n}\n\n.role-tile, .metric-strip > div, .result-grid > div {\n  padding: 20px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: rgba(var(--surface-rgb), var(--scrim-78));\n  text-decoration: none;\n}\n\n.role-tile span, .metric-strip span, .result-grid span, .row-stat span {\n  display: block;\n  color: var(--muted);\n  font-size: .88rem;\n}\n\n.role-tile strong, .metric-strip strong, .result-grid strong, .row-stat strong {\n  display: block;\n  font-size: clamp(1.5rem, 4vw, 2.4rem);\n}\n\n.auth-layout { align-items: start; }\n.auth-compact { max-width: 920px; margin: 0 auto; }\n\n.tabs a {\n  padding: 10px 14px;\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  background: var(--surface);\n  text-decoration: none;\n  font-weight: 900;\n}\n\n.tabs a.active { background: var(--ink); color: var(--white); border-color: var(--ink); }\n\n.form-card {\n  display: grid;\n  gap: 14px;\n  padding: clamp(20px, 4vw, 34px);\n  border: 1px solid var(--line);\n  border-radius: 24px;\n  background: rgba(var(--surface-rgb), var(--scrim-86));\n  box-shadow: 0 22px 50px rgba(36, 48, 68, .08);\n}\n\n.form-card h2 { margin: 0 0 6px; }\n.form-card label { display: grid; gap: 7px; color: var(--muted); font-weight: 800; }\n.form-card input, .form-card select, .spelling-card input {\n  width: 100%;\n  min-height: 46px;\n  padding: 12px 14px;\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  background: var(--surface);\n  color: var(--ink);\n  font: inherit;\n}\n\n.form-card input:focus, .form-card select:focus, .spelling-card input:focus {\n  outline: 3px solid rgba(248, 200, 75, .35);\n  border-color: var(--sun);\n}\n\n.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\n.check-row { grid-template-columns: auto 1fr; align-items: center; }\n.check-row input { min-height: auto; width: auto; }\n.form-note { margin: 4px 0 0; color: var(--muted); text-align: center; }\n\n.dashboard-hero {\n  padding: clamp(22px, 4vw, 36px);\n  border-radius: 28px;\n  background: linear-gradient(135deg, var(--sun-soft), rgba(var(--surface-rgb), var(--scrim-65)));\n  margin-bottom: 18px;\n}\n\n.learner-hero { background: linear-gradient(135deg, var(--sun-soft), var(--mint-soft)); }\n.parent-hero { background: linear-gradient(135deg, var(--lavender-soft), var(--surface)); }\n.teacher-hero { background: linear-gradient(135deg, var(--auto-d6f7f5-bg), var(--surface)); }\n\n.lesson-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  gap: 16px;\n  margin-top: 18px;\n}\n\n.lesson-card {\n  display: grid;\n  grid-template-columns: 86px 1fr;\n  gap: 16px;\n  padding: 16px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--surface);\n  text-decoration: none;\n}\n\n.lesson-cover, .avatar {\n  display: grid;\n  place-items: center;\n  border-radius: 18px;\n  background: var(--mint-soft);\n  color: var(--success);\n  font-size: 2rem;\n  font-weight: 900;\n}\n\n.lesson-info h2 { margin: 10px 0 4px; font-size: 1.2rem; }\n.lesson-info p { margin: 0 0 8px; color: var(--muted); }\n\n.badge {\n  display: inline-flex;\n  width: max-content;\n  padding: 5px 9px;\n  border-radius: 999px;\n  font-size: .76rem;\n  font-weight: 900;\n}\n\n.badge-new { background: var(--sun-soft); }\n.badge-done { background: var(--mint-soft); color: var(--success); }\n\n.activity-shell {\n  max-width: 860px;\n  margin: 0 auto;\n  padding: clamp(20px, 4vw, 34px);\n  border-radius: 28px;\n  background: rgba(var(--surface-rgb), var(--scrim-82));\n  border: 1px solid var(--line);\n}\n\n.activity-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 18px;\n}\n\n.back-link { color: var(--muted); font-weight: 900; text-decoration: none; }\n\n/* Learner activity dialogs: fixed centre overlays so they never enter the page flow. */\nbody:not(.diagram-body) .learner-modal {\n  position: fixed;\n  inset: 0;\n  z-index: 10000;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: rgba(36, 48, 68, .58);\n  backdrop-filter: blur(4px);\n}\n\nbody:not(.diagram-body) .learner-modal.hidden { display: none !important; }\n\nbody:not(.diagram-body) .learner-modal-card {\n  position: relative;\n  width: min(100%, 460px);\n  max-height: min(760px, calc(100vh - 48px));\n  overflow-y: auto;\n  padding: 78px 28px 28px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--white);\n  box-shadow: none;\n  text-align: center;\n}\n\nbody:not(.diagram-body) .learner-modal-banner {\n  position: absolute;\n  top: 16px;\n  left: 50%;\n  transform: translateX(-50%);\n  min-width: 190px;\n  padding: 11px 24px;\n  border: 1px solid var(--mint);\n  border-radius: 999px;\n  background: var(--mint-soft);\n  color: var(--ink);\n  font-size: 1rem;\n  font-weight: 900;\n  letter-spacing: .02em;\n}\n\nbody:not(.diagram-body) .learner-modal-close {\n  position: absolute;\n  top: 14px;\n  right: 14px;\n  z-index: 1;\n  display: inline-grid;\n  width: 50px;\n  height: 50px;\n  place-items: center;\n  padding: 0;\n  border: 1px solid var(--line);\n  border-radius: 50%;\n  background: var(--sun-soft);\n  box-shadow: none;\n  color: var(--ink);\n  cursor: pointer;\n  font-size: 2.15rem;\n  font-weight: 900;\n  line-height: 1;\n}\n\nbody:not(.diagram-body) .learner-modal-card h2 {\n  margin: 0 24px 10px;\n  color: var(--ink);\n  font-size: clamp(1.35rem, 4vw, 1.8rem);\n}\n\nbody:not(.diagram-body) #activity-picker-title { color: #000; }\n\nbody:not(.diagram-body) .learner-modal-card p { color: #56617a; font-weight: 700; }\n[data-theme="dark"] body:not(.diagram-body) .learner-modal-card {\n  background: #0f172a;\n  border-color: rgba(148, 163, 184, .45);\n}\n[data-theme="dark"] body:not(.diagram-body) .learner-modal-card h2,\n[data-theme="dark"] body:not(.diagram-body) .learner-modal-card p,\n[data-theme="dark"] body:not(.diagram-body) .activity-pause-score {\n  color: #f8fbff;\n}\nbody:not(.diagram-body) .learner-modal-options { display: grid; gap: 12px; margin: 22px 0 16px; }\nbody:not(.diagram-body) .learner-modal-options .btn { width: 100%; min-height: 52px; font-size: 1.05rem; }\nbody:not(.diagram-body) .learner-modal-options .btn-primary { background: var(--sun); border-color: var(--sun); color: var(--ink); box-shadow: none; }\nbody:not(.diagram-body) .learner-modal-options .btn-light { background: var(--lavender-soft); border-color: var(--lavender); color: var(--ink); box-shadow: none; }\n\nbody:not(.diagram-body) .activity-top .back-link {\n  position: relative;\n  z-index: 1;\n  display: inline-flex;\n  min-height: 40px;\n  align-items: center;\n  padding: 0 10px;\n  border-radius: 10px;\n  cursor: pointer;\n}\n\nbody:not(.diagram-body) .activity-top .back-link:hover,\nbody:not(.diagram-body) .activity-top .back-link:focus-visible { background: #eef5ff; color: #215fa4; outline: 3px solid rgba(48, 140, 235, .25); }\nbody:not(.diagram-body) .activity-pause-button { margin-left: auto; }\n.step-pill { padding: 8px 12px; border-radius: 999px; background: var(--lavender-soft); font-weight: 900; }\n\n.story-book, .activity-grid, .pronunciation-list, .spelling-form, .learner-list {\n  display: grid;\n  gap: 14px;\n  margin-top: 22px;\n}\n\n.story-page, .activity-card, .pronunciation-card, .spelling-card, .learner-row {\n  padding: 18px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--surface);\n}\n\n.story-image, .picture-placeholder {\n  display: grid;\n  min-height: 170px;\n  place-items: center;\n  margin-bottom: 16px;\n  border-radius: 16px;\n  background: linear-gradient(135deg, var(--mint-soft), var(--sun-soft));\n  color: var(--muted);\n  text-align: center;\n}\n\n.story-text { font-size: 1.28rem; line-height: 1.7; }\n.audio-bar { color: var(--muted); font-weight: 700; }\n\n.story-nav, .center {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 14px;\n  margin-top: 20px;\n  flex-wrap: wrap;\n}\n