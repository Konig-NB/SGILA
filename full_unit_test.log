ent(\'button\');\n    button.type = \'button\';\n    button.className = \'cloze-chip\';\n    button.textContent = word;\n    button.dataset.answer = word;\n    button.setAttribute(\'aria-pressed\', \'false\');\n    button.addEventListener(\'click\', () => {\n      bank.querySelectorAll(\'.cloze-chip\').forEach((chip) => {\n        chip.classList.remove(\'is-selected\');\n        chip.setAttribute(\'aria-pressed\', \'false\');\n      });\n      button.classList.add(\'is-selected\');\n      button.setAttribute(\'aria-pressed\', \'true\');\n      selectedAnswer = word;\n      selectedButton = button;\n      if (phonicsBlank) {\n        phonicsBlank.textContent = word;\n        phonicsBlank.classList.add(\'has-letter\');\n        phonicsWord.setAttribute(\n          \'aria-label\',\n          `Completed word: ${String(config.display_word).replace(\'_\', word)}`,\n        );\n      }\n      submit.disabled = false;\n    });\n    bank.appendChild(button);\n  });\n\n  const submit = makeSubmitButton(\'Check the word\');\n  submit.disabled = true;\n  submit.addEventListener(\'click\', () => submitActivity(activity, selectedAnswer, selectedButton));\n  responseArea.append(bank, submit);\n}\n\nfunction renderSequence(activity) {\n  const list = document.createElement(\'ol\');\n  list.className = \'sequence-list\';\n  const config = activityConfig(activity);\n  const itemImages = config.item_images || {};\n  let draggedRow = null;\n\n  activity.items.forEach((item) => {\n    const row = document.createElement(\'li\');\n    row.draggable = true;\n    row.classList.add(\'sequence-draggable\');\n    row.setAttribute(\'aria-label\', `Drag to reorder: ${item}`);\n    if (itemImages[item]) {\n      row.classList.add(\'has-picture\');\n      row.appendChild(createActivityVisual(itemImages[item], item));\n    }\n    const text = document.createElement(\'span\');\n    text.className = \'sequence-copy\';\n    text.textContent = item;\n    const controls = document.createElement(\'div\');\n    controls.className = \'sequence-controls\';\n\n    row.addEventListener(\'dragstart\', (event) => {\n      draggedRow = row;\n      row.classList.add(\'is-dragging\');\n      event.dataTransfer.effectAllowed = \'move\';\n      event.dataTransfer.setData(\'text/plain\', item);\n    });\n\n    row.addEventListener(\'dragend\', () => {\n      draggedRow = null;\n      list.querySelectorAll(\'li\').forEach((entry) => {\n        entry.classList.remove(\'is-dragging\', \'drag-over\');\n      });\n    });\n\n    row.addEventListener(\'dragover\', (event) => {\n      event.preventDefault();\n      if (draggedRow && draggedRow !== row) row.classList.add(\'drag-over\');\n    });\n\n    row.addEventListener(\'dragleave\', () => row.classList.remove(\'drag-over\'));\n\n    row.addEventListener(\'drop\', (event) => {\n      event.preventDefault();\n      row.classList.remove(\'drag-over\');\n      if (!draggedRow || draggedRow === row) return;\n      const rows = [...list.children];\n      const draggedIndex = rows.indexOf(draggedRow);\n      const targetIndex = rows.indexOf(row);\n      if (draggedIndex < targetIndex) list.insertBefore(draggedRow, row.nextSibling);\n      else list.insertBefore(draggedRow, row);\n    });\n\n    const up = document.createElement(\'button\');\n    up.type = \'button\';\n    up.className = \'sequence-move\';\n    up.textContent = \'\\u2191\';\n    up.title = \'Move earlier\';\n    up.setAttribute(\'aria-label\', `Move ${item} earlier`);\n    up.addEventListener(\'click\', () => {\n      const previous = row.previousElementSibling;\n      if (previous) list.insertBefore(row, previous);\n    });\n\n    const down = document.createElement(\'button\');\n    down.type = \'button\';\n    down.className = \'sequence-move\';\n    down.textContent = \'\\u2193\';\n    down.title = \'Move later\';\n    down.setAttribute(\'aria-label\', `Move ${item} later`);\n    down.addEventListener(\'click\', () => {\n      const next = row.nextElementSibling;\n      if (next) list.insertBefore(next, row);\n    });\n\n    controls.append(up, down);\n    row.append(text, controls);\n    list.appendChild(row);\n  });\n\n  const submit = makeSubmitButton(\'Check the order\');\n  submit.addEventListener(\'click\', () => {\n    const answer = [...list.querySelectorAll(\'.sequence-copy\')].map((item) => item.textContent);\n    submitActivity(activity, answer);\n  });\n  responseArea.append(list, submit);\n}\n\nfunction renderCrossword(activity) {\n  const config = activity.options || {};\n  const entries = config.entries || [];\n  const rows = Number(config.rows || 0);\n  const columns = Number(config.columns || 0);\n  const cells = new Map();\n\n  entries.forEach((entry) => {\n    for (let offset = 0; offset < entry.length; offset++) {\n      const row = entry.row + (entry.direction === \'Down\' ? offset : 0);\n      const column = entry.column + (entry.direction === \'Across\' ? offset : 0);\n      const key = `${row}-${column}`;\n      const cell = cells.get(key) || {row, column, numbers: []};\n      if (offset === 0 && !cell.numbers.includes(entry.number)) cell.numbers.push(entry.number);\n      cells.set(key, cell);\n    }\n  });\n\n  const layout = document.createElement(\'div\');\n  layout.className = \'crossword-layout\';\n  const grid = document.createElement(\'div\');\n  grid.className = \'crossword-grid\';\n  grid.style.setProperty(\'--crossword-columns\', columns);\n  grid.setAttribute(\'aria-label\', \'Crossword answer grid\');\n\n  const focusNextCrosswordCell = (input) => {\n    const cells = [...grid.querySelectorAll(\'input[data-cell]\')];\n    const nextCell = cells[cells.indexOf(input) + 1];\n    if (nextCell) nextCell.focus();\n  };\n\n  const focusCrosswordCell = (input, rowStep, columnStep) => {\n    const [row, column] = input.dataset.cell.split(\'-\').map(Number);\n    const candidates = [...grid.querySelectorAll(\'input[data-cell]\')]\n      .map((cell) => ({\n        cell,\n        row: Number(cell.dataset.cell.split(\'-\')[0]),\n        column: Number(cell.dataset.cell.split(\'-\')[1]),\n      }))\n      .filter((candidate) => (\n        (rowStep && candidate.column === column && (candidate.row - row) * rowStep > 0)\n        || (columnStep && candidate.row === row && (candidate.column - column) * columnStep > 0)\n      ))\n      .sort((first, second) => {\n        const firstDistance = Math.abs(first.row - row) + Math.abs(first.column - column);\n        const secondDistance = Math.abs(second.row - row) + Math.abs(second.column - column);\n        return firstDistance - secondDistance;\n      });\n    if (candidates[0]) candidates[0].cell.focus();\n  };\n\n  for (let row = 0; row < rows; row++) {\n    for (let column = 0; column < columns; column++) {\n      const key = `${row}-${column}`;\n      const data = cells.get(key);\n      const cell = document.createElement(\'div\');\n      cell.className = data ? \'crossword-cell\' : \'crossword-block\';\n      if (data) {\n        if (data.numbers.length) {\n          const number = document.createElement(\'span\');\n          number.textContent = data.numbers.join(\'/\');\n          cell.appendChild(number);\n        }\n        const input = document.createElement(\'input\');\n        input.maxLength = 1;\n        input.autocomplete = \'off\';\n        input.dataset.cell = key;\n        input.setAttribute(\'aria-label\', `Crossword row ${row + 1}, column ${column + 1}`);\n        input.addEventListener(\'input\', () => {\n          input.value = input.value.replace(/[^A-Za-z]/g, \'\').toUpperCase();\n          if (input.value) focusNextCrosswordCell(input);\n        });\n        input.addEventListener(\'keydown\', (event) => {\n          const directions = {\n            ArrowUp: [-1, 0],\n            ArrowDown: [1, 0],\n            ArrowLeft: [0, -1],\n            ArrowRight: [0, 1],\n          };\n          const direction = directions[event.key];\n          if (!direction) return;\n          const [rowStep, columnStep] = direction;\n          const previousFocus = document.activeElement;\n          focusCrosswordCell(input, rowStep, columnStep);\n          if (document.activeElement !== previousFocus) event.preventDefault();\n        });\n        cell.appendChild(input);\n      }\n      grid.appendChild(cell);\n    }\n  }\n\n  const clues = document.createElement(\'div\');\n  clues.className = \'crossword-clues\';\n  [\'Across\', \'Down\'].forEach((direction) => {\n    const section = document.createElement(\'section\');\n    const heading = document.createElement(\'h3\');\n    heading.textContent = direction;\n    section.appendChild(heading);\n    entries.filter((entry) => entry.direction === direction).forEach((entry) => {\n      const clue = document.createElement(\'p\');\n      clue.innerHTML = `<strong>${entry.number}.</strong> ${entry.clue} <small>(${entry.length} letters)</small>`;\n      section.appendChild(clue);\n    });\n    clues.appendChild(section);\n  });\n  layout.append(grid, clues);\n\n  const submit = makeSubmitButton(\'Check crossword\');\n  submit.addEventListener(\'click\', () => {\n    const answer = {};\n    entries.forEach((entry) => {\n      let word = \'\';\n      for (let offset = 0; offset < entry.length; offset++) {\n        const row = entry.row + (entry.direction === \'Down\' ? offset : 0);\n        const column = entry.column + (entry.direction === \'Across\' ? offset : 0);\n        word += grid.querySelector(`[data-cell="${row}-${column}"]`).value;\n      }\n      answer[entry.key] = word;\n    });\n    submitActivity(activity, answer);\n  });\n  responseArea.append(layout, submit);\n}\n\nfunction renderDragMatch(activity) {\n  const config = activityConfig(activity);\n  const board = document.createElement(\'div\');\n  board.className = \'drag-match-board\';\n  const tray = document.createElement(\'div\');\n  tray.className = \'drag-match-tray\';\n  const targets = document.createElement(\'div\');\n  targets.className = \'drag-match-targets\';\n  const assignments = {};\n  let selectedPrompt = \'\';\n\n  function updateSubmit() {\n    submit.disabled = Object.keys(assignments).length !== (config.prompts || []).length;\n  }\n\n  function assign(promptKey, choiceKey) {\n    if (!promptKey || !choiceKey) return;\n    Object.keys(assignments).forEach((key) => {\n      if (assignments[key] === choiceKey) delete assignments[key];\n    });\n    assignments[promptKey] = choiceKey;\n    tray.querySelectorAll(\'.drag-match-chip\').forEach((chip) => {\n      chip.classList.toggle(\'is-matched\', Boolean(assignments[chip.dataset.prompt]));\n      chip.classList.remove(\'is-selected\');\n    });\n    targets.querySelectorAll(\'.drag-match-target\').forEach((target) => {\n      const prompt = Object.keys(assignments).find((key) => assignments[key] === target.dataset.choice) || \'\';\n      target.dataset.prompt = prompt;\n      const promptData = (config.prompts || []).find((item) => item.key === prompt);\n      target.querySelector(\'.drag-match-slot\').textContent = promptData ? promptData.text : \'Drop a picture here\';\n      target.classList.toggle(\'has-match\', Boolean(prompt));\n    });\n    selectedPrompt = \'\';\n    updateSubmit();\n  }\n\n  (config.prompts || []).forEach((prompt) => {\n    const chip = document.createElement(\'button\');\n    chip.type = \'button\';\n    chip.className = \'drag-match-chip\';\n    chip.dataset.prompt = prompt.key;\n    chip.draggable = true;\n    if (prompt.image_url) chip.appendChild(createActivityVisual(prompt.image_url, prompt.text));\n    const label = document.createElement(\'span\');\n    label.textContent = prompt.text;\n    chip.appendChild(label);\n    chip.addEventListener(\'click\', () => {\n      selectedPrompt = prompt.key;\n      tray.querySelectorAll(\'.drag-match-chip\').forEach((item) => item.classList.toggle(\'is-selected\', item === chip));\n    });\n    chip.addEventListener(\'dragstart\', (event) => event.dataTransfer.setData(\'text/plain\', prompt.key));\n    tray.appendChild(chip);\n  });\n\n  (config.choices || []).forEach((choice) => {\n    const target = document.createElement(\'button\');\n    target.type = \'button\';\n    target.className = \'drag-match-target\';\n    target.dataset.choice = choice.key;\n    if (choice.image_url) target.appendChild(createActivityVisual(choice.image_url, choice.text));\n    const label = document.createElement(\'strong\');\n    label.textContent = choice.text;\n    const slot = document.createElement(\'span\');\n    slot.className = \'drag-match-slot\';\n    slot.textContent = \'Drop a picture here\';\n    target.append(label, slot);\n    target.addEventListener(\'click\', () => assign(selectedPrompt, choice.key));\n    target.addEventListener(\'dragover\', (event) => event.preventDefault());\n    target.addEventListener(\'drop\', (event) => {\n      event.preventDefault();\n      assign(event.dataTransfer.getData(\'text/plain\'), choice.key);\n    });\n    targets.appendChild(target);\n  });\n\n  const trayTitle = document.createElement(\'strong\');\n  trayTitle.className = \'drag-match-heading\';\n  trayTitle.textContent = \'Pictures\';\n  tray.prepend(trayTitle);\n  const targetTitle = document.createElement(\'strong\');\n  targetTitle.className = \'drag-match-heading\';\n  targetTitle.textContent = \'Story places\';\n  targets.prepend(targetTitle);\n  board.append(tray, targets);\n\n  const submit = makeSubmitButton(\'Check matches\');\n  submit.disabled = true;\n  submit.addEventListener(\'click\', () => submitActivity(activity, assignments));\n  responseArea.append(board, submit);\n}\n\nfunction renderMatching(activity) {\n  const config = activity.options || {};\n  const isGradeFourMatching = Number(\'{{ lesson.grade }}\') === 4\n    && Array.isArray(config.prompts)\n    && Array.isArray(config.choices);\n\n  if (config.presentation === \'drag_match\') {\n    renderDragMatch(activity);\n    return;\n  }\n\n  if (isGradeFourMatching) {\n    const promptColors = [\'blue\', \'orange\', \'yellow\', \'purple\'];\n    const currentMatches = {};\n    let activePromptKey = null;\n\n    const board = document.createElement(\'div\');\n    board.className = \'matching-board\';\n\n    const promptsCol = document.createElement(\'div\');\n    promptsCol.className = \'matching-prompt-cards\';\n\n    const choicesCol = document.createElement(\'div\');\n    choicesCol.className = \'matching-choice-cards\';\n\n    const promptCards = {};\n    const choiceCards = {};\n\n    function updateMatchStyles() {\n      Object.entries(promptCards).forEach(([promptKey, card]) => {\n        const isSelected = activePromptKey === promptKey;\n        const isMatched = Boolean(currentMatches[promptKey]);\n        card.classList.toggle(\'is-active\', isSelected);\n        card.classList.toggle(\'is-matched\', isMatched);\n        if (isMatched) {\n          card.style.borderColor = card.dataset.color || \'blue\';\n          card.style.backgroundColor = `${card.dataset.color || \'blue\'}18`;\n        } else {\n          card.style.borderColor = card.dataset.color || \'blue\';\n          card.style.backgroundColor = \'\';\n        }\n      });\n\n      Object.entries(choiceCards).forEach(([choiceKey, card]) => {\n        const matchedPrompt = Object.keys(currentMatches).find((promptKey) => currentMatches[promptKey] === choiceKey);\n        const isMatched = Boolean(matchedPrompt);\n        card.classList.toggle(\'is-matched\', isMatched);\n        if (isMatched) {\n          const promptCard = promptCards[matchedPrompt];\n          const color = promptCard ? promptCard.dataset.color : \'blue\';\n          card.style.borderColor = color;\n          card.style.backgroundColor = `${color}18`;\n        } else {\n          card.style.borderColor = \'\';\n          card.style.backgroundColor = \'\';\n        }\n      });\n    }\n\n    (config.prompts || []).forEach((prompt, promptIndex) => {\n      const color = promptColors[promptIndex % promptColors.length];\n      const card = document.createElement(\'button\');\n      card.type = \'button\';\n      card.className = \'matching-prompt-card\';\n      card.dataset.prompt = prompt.key;\n      card.dataset.color = color;\n      card.setAttribute(\'aria-label\', `Prompt: ${prompt.text}`);\n      card.style.borderColor = color;\n      card.textContent = prompt.text;\n      card.addEventListener(\'click\', () => {\n        if (activePromptKey === prompt.key) {\n          activePromptKey = null;\n        } else {\n          activePromptKey = prompt.key;\n        }\n        updateMatchStyles();\n      });\n      promptCards[prompt.key] = card;\n      promptsCol.appendChild(card);\n    });\n\n    (config.choices || []).forEach((choice) => {\n      const card = document.createElement(\'button\');\n      card.type = \'button\';\n      card.className = \'matching-choice-card\';\n      card.dataset.choice = choice.key;\n      card.setAttribute(\'aria-label\', `Choice: ${choice.text}`);\n      card.textContent = choice.text;\n      card.addEventListener(\'click\', () => {\n        if (!activePromptKey) return;\n\n        const promptKey = activePromptKey;\n        const choiceKey = card.dataset.choice;\n        const previousPromptForChoice = Object.keys(currentMatches).find((key) => currentMatches[key] === choiceKey);\n\n        if (previousPromptForChoice && previousPromptForChoice !== promptKey) {\n          delete currentMatches[previousPromptForChoice];\n        }\n\n        if (currentMatches[promptKey] === choiceKey) {\n          delete currentMatches[promptKey];\n          activePromptKey = null;\n        } else {\n          currentMatches[promptKey] = choiceKey;\n          activePromptKey = null;\n        }\n\n        updateMatchStyles();\n      });\n      choiceCards[choice.key] = card;\n      choicesCol.appendChild(card);\n    });\n\n    board.append(promptsCol, choicesCol);\n    responseArea.append(board);\n\n    const submit = makeSubmitButton(\'Check matches\');\n    submit.addEventListener(\'click\', () => {\n      window.sgilaCurrentMatches = { ...currentMatches };\n      submitActivity(activity, { ...currentMatches });\n    });\n    responseArea.append(submit);\n    return;\n  }\n\n  const board = document.createElement(\'div\');\n  board.className = \'matching-board\';\n  const words = document.createElement(\'div\');\n  words.className = \'matching-word-bank\';\n  const meanings = document.createElement(\'div\');\n  meanings.className = \'matching-meaning-bank\';\n  const assignments = {};\n  const promptByChoice = {};\n  const promptColors = [\'blue\', \'orange\', \'yellow\', \'purple\'];\n  const colorByPrompt = {};\n  let selectedPrompt = \'\';\n  const matchedPairs = document.createElement(\'div\');\n  matchedPairs.className = \'matching-pairs\';\n\n  const promptText = (promptKey) => (\n    (config.prompts || []).find((prompt) => prompt.key === promptKey)?.text || promptKey\n  );\n\n  const updateBoard = () => {\n    words.querySelectorAll(\'button\').forEach((word) => {\n      const promptKey = word.dataset.prompt;\n      const choiceKey = assignments[promptKey] || \'\';\n      word.dataset.choice = choiceKey;\n      word.classList.toggle(\'is-selected\', word.dataset.prompt === selectedPrompt);\n      word.classList.toggle(\'is-matched\', Boolean(choiceKey));\n      word.hidden = Boolean(choiceKey);\n    });\n    meanings.querySelectorAll(\'button\').forEach((meaning) => {\n      const promptKey = promptByChoice[meaning.dataset.choice] || \'\';\n      meaning.classList.toggle(\'is-matched\', Boolean(promptKey));\n      meaning.classList.toggle(\'is-selected\', meaning.dataset.choice === assignments[selectedPrompt]);\n      meaning.hidden = Boolean(promptKey);\n      meaning.style.borderColor = promptKey ? colorByPrompt[promptKey] : \'\';\n      meaning.style.backgroundColor = promptKey\n        ? `color-mix(in srgb, ${colorByPrompt[promptKey]} 12%, var(--surface))`\n        : \'\';\n      meaning.setAttribute(\'aria-label\', promptKey\n        ? `${meaning.textContent}, matched with ${promptText(promptKey)}`\n        : meaning.textContent);\n    });\n\n    matchedPairs.replaceChildren();\n    Object.entries(assignments).forEach(([promptKey, choiceKey]) => {\n      const color = colorByPrompt[promptKey];\n      const pair = document.createElement(\'div\');\n      pair.className = \'matching-pair\';\n      pair.dataset.prompt = promptKey;\n      pair.dataset.choice = choiceKey;\n\n      const word = document.createElement(\'button\');\n      word.type = \'button\';\n      word.className = \'matching-pair-card matching-pair-word\';\n      word.style.borderColor = color;\n      word.style.backgroundColor = `color-mix(in srgb, ${color} 12%, var(--surface))`;\n      word.setAttribute(\'aria-label\', `Matched word ${promptText(promptKey)}. Select to change this match.`);\n      const dot = document.createElement(\'span\');\n      dot.className = \'matching-dot\';\n      dot.style.backgroundColor = color;\n      const wordLabel = document.createElement(\'span\');\n      wordLabel.textContent = promptText(promptKey);\n      word.append(dot, wordLabel);\n\n      const meaning = document.createElement(\'button\');\n      meaning.type = \'button\';\n      meaning.className = \'matching-pair-card\';\n      meaning.style.borderColor = color;\n      meaning.style.backgroundColor = `color-mix(in srgb, ${color} 12%, var(--surface))`;\n      const choiceText = (config.choices || []).find((item) => item.key === choiceKey)?.text || choiceKey;\n      meaning.setAttribute(\'aria-label\', `Matched meaning ${choiceText}. Select to change this match.`);\n      meaning.textContent = choiceText;\n\n      const clearMatch = () => {\n        delete assignments[promptKey];\n        delete promptByChoice[choiceKey];\n        selectedPrompt = promptKey;\n        updateBoard();\n        submit.disabled = Object.keys(assignments).length !== (config.prompts || []).length;\n      };\n      word.addEventListener(\'click\', clearMatch);\n      meaning.addEventListener(\'click\', clearMatch);\n      pair.append(word, meaning);\n      matchedPairs.appendChild(pair);\n    });\n  };\n\n  const assignChoice = (promptKey, choiceKey) => {\n    if (!promptKey || !choiceKey) return;\n    const previousChoice = assignments[promptKey];\n    if (previousChoice) delete promptByChoice[previousChoice];\n    const previousPrompt = promptByChoice[choiceKey];\n    if (previousPrompt) delete assignments[previousPrompt];\n    assignments[promptKey] = choiceKey;\n    promptByChoice[choiceKey] = promptKey;\n    selectedPrompt = promptKey;\n    updateBoard();\n    submit.disabled = Object.keys(assignments).length !== (config.prompts || []).length;\n  };\n\n  (config.prompts || []).forEach((prompt) => {\n    const color = promptColors[Object.keys(colorByPrompt).length % promptColors.length];\n    colorByPrompt[prompt.key] = color;\n    const word = document.createElement(\'button\');\n    word.type = \'button\';\n    word.className = \'matching-word\';\n    word.dataset.prompt = prompt.key;\n    word.draggable = true;\n    word.style.borderColor = color;\n    word.setAttribute(\'aria-label\', `Word: ${prompt.text}`);\n    const dot = document.createElement(\'span\');\n    dot.className = \'matching-dot\';\n    dot.style.backgroundColor = color;\n    const label = document.createElement(\'span\');\n    label.textContent = prompt.text;\n    word.append(dot, label);\n    word.addEventListener(\'click\', () => {\n      selectedPrompt = prompt.key;\n      updateBoard();\n    });\n    word.addEventListener(\'dragstart\', (event) => {\n      selectedPrompt = prompt.key;\n      event.dataTransfer.setData(\'text/plain\', prompt.key);\n      updateBoard();\n    });\n    words.appendChild(word);\n  });\n\n  (config.choices || []).forEach((choice) => {\n    const meaning = document.createElement(\'button\');\n    meaning.type = \'button\';\n    meaning.className = \'matching-meaning\';\n    meaning.dataset.choice = choice.key;\n    meaning.textContent = choice.text;\n    meaning.addEventListener(\'click\', () => assignChoice(selectedPrompt, choice.key));\n    meaning.addEventListener(\'pointerup\', () => assignChoice(selectedPrompt, choice.key));\n    meaning.addEventListener(\'dragover\', (event) => event.preventDefault());\n    meaning.addEventListener(\'drop\', (event) => {\n      event.preventDefault();\n      assignChoice(event.dataTransfer.getData(\'text/plain\'), choice.key);\n    });\n    meanings.appendChild(meaning);\n  });\n\n  const wordsTitle = document.createElement(\'strong\');\n  wordsTitle.className = \'matching-column-title\';\n  wordsTitle.textContent = \'Words\';\n  words.prepend(wordsTitle);\n  const meaningsTitle = document.createElement(\'strong\');\n  meaningsTitle.className = \'matching-column-title\';\n  meaningsTitle.textContent = \'Meanings\';\n  meanings.prepend(meaningsTitle);\n  board.append(words, meanings);\n  responseArea.append(board, matchedPairs);\n\n  const submit = makeSubmitButton(\'Check matches\');\n  submit.disabled = true;\n  submit.addEventListener(\'click\', () => {\n    submitActivity(activity, assignments);\n  });\n  responseArea.append(submit);\n}\n\nfunction renderWordScramble(activity) {\n  const config = activity.options || {};\n  const rows = document.createElement(\'div\');\n  rows.className = \'scramble-rows\';\n  (config.items || []).forEach((item) => {\n    const row = document.createElement(\'label\');\n    row.className = \'scramble-row\';\n    const letters = document.createElement(\'strong\');\n    letters.textContent = item.scramble.split(\'\').join(\' \');\n    const input = document.createElement(\'input\');\n    input.type = \'text\';\n    input.autocomplete = \'off\';\n    input.dataset.item = item.key;\n    input.placeholder = \'Type the word\';\n    row.append(letters, input);\n    rows.appendChild(row);\n  });\n  const submit = makeSubmitButton(\'Check spelling\');\n  submit.addEventListener(\'click\', () => {\n    const answer = {};\n    rows.querySelectorAll(\'input\').forEach((input) => answer[input.dataset.item] = input.value);\n    submitActivity(activity, answer);\n  });\n  responseArea.append(rows, submit);\n}\n\nfunction renderOral(activity) {\n  const config = activityConfig(activity);\n  const oral = document.createElement(\'div\');\n  oral.className = \'oral-response\';\n  const title = document.createElement(\'strong\');\n  title.textContent = config.focus_word ? `Say the word: ${config.focus_word}` : \'Say it in a full sentence\';\n  const help = document.createElement(\'span\');\n  help.textContent = config.focus_word\n    ? \'Listen, say the word clearly, then tick it as complete.\'\n    : \'Tell the answer to a teacher, parent, or learning partner.\';\n  oral.append(title, help);\n\n  const label = document.createElement(\'label\');\n  label.className = \'reading-response-label\';\n  label.setAttribute(\'for\', \'oral-response\');\n  label.textContent = \'Your spoken answer\';\n\n  const answer = document.createElement(\'textarea\');\n  answer.id = \'oral-response\';\n  answer.className = \'reading-response\';\n  answer.rows = 3;\n  answer.maxLength = 600;\n  answer.placeholder = \'Speak or type your answer here.\';\n\n  const dictationWrap = attachDictationToTextarea(answer);\n\n  const submit = makeSubmitButton(config.focus_word ? \'I said the word\' : \'I said my answer\');\n  submit.addEventListener(\'click\', () => {\n    const spokenText = (answer.value || \'\').trim();\n    submitActivity(activity, spokenText || \'Answered aloud\');\n  });\n\n  responseArea.append(label, dictationWrap || answer, submit);\n}\n\nfunction attachDictationToTextarea(textarea) {\n  const SpeechRecognitionCtor = window.SpeechRecognition || window.webkitSpeechRecognition || window.mozSpeechRecognition;\n  const wrap = document.createElement(\'div\');\n  wrap.className = \'dictation-wrap\';\n\n  const mic = document.createElement(\'button\');\n  mic.type = \'button\';\n  mic.className = \'btn btn-light dictation-btn\';\n  mic.textContent = \'\U0001f399 Speak\';\n  mic.title = \'Use microphone to dictate your answer\';\n\n  if (!SpeechRecognitionCtor) {\n    mic.disabled = true;\n    mic.textContent = \'Mic unavailable\';\n    mic.title = \'Speech recognition is not supported in this browser.\';\n    wrap.append(textarea, mic);\n    return wrap;\n  }\n\n  let recognition = null;\n  let listening = false;\n\n  const stopListening = () => {\n    if (recognition) {\n      try { recognition.stop(); } catch (error) {}\n    }\n    listening = false;\n    mic.textContent = \'\U0001f399 Speak again\';\n    mic.classList.remove(\'is-listening\');\n  };\n\n  const startListening = () => {\n    recognition = new SpeechRecognitionCtor();\n    recognition.lang = \'en-ZA\';\n    recognition.continuous = false;\n    recognition.interimResults = false;\n    recognition.maxAlternatives = 1;\n\n    recognition.onstart = () => {\n      listening = true;\n      mic.textContent = \'\u23f9 Stop\';\n      mic.classList.add(\'is-listening\');\n      textarea.focus();\n    };\n\n    recognition.onresult = (event) => {\n      const transcript = Array.from(event.results)\n        .map((result) => result[0].transcript)\n        .join(\' \')\n        .trim();\n\n      if (transcript) {\n        textarea.value = transcript;\n        textarea.focus();\n      }\n    };\n\n    recognition.onerror = (event) => {\n      const message = event.error === \'not-allowed\'\n        ? \'Microphone permission is needed to use speech-to-text.\'\n        : \'Speech recognition is not available right now. Please type your answer instead.\';\n      textarea.setAttribute(\'placeholder\', message);\n      stopListening();\n      textarea.focus();\n    };\n\n    recognition.onend = () => {\n      if (listening) stopListening();\n    };\n\n    try {\n      recognition.start();\n    } catch (error) {\n      stopListening();\n      textarea.focus();\n    }\n  };\n\n  mic.addEventListener(\'click\', () => {\n    if (listening) {\n      stopListening();\n      return;\n    }\n    startListening();\n  });\n\n  wrap.append(textarea, mic);\n  return wrap;\n}\n\nfunction renderWritten(activity) {\n  const label = document.createElement(\'label\');\n  label.className = \'reading-response-label\';\n  label.setAttribute(\'for\', \'reading-response\');\n  label.textContent = activity.activity_type === \'prediction\' ? \'Your prediction and clue\' : \'Your answer\';\n\n  const answer = document.createElement(\'textarea\');\n  answer.id = \'reading-response\';\n  answer.className = \'reading-response\';\n  answer.rows = 3;\n  answer.maxLength = 600;\n  answer.placeholder = activity.activity_type === \'prediction\'\n    ? \'I think ... because ...\'\n    : (activity.activity_type === \'open_ended\' ? \'Write two or more sentences. Use punctuation.\' : \'Write one clear sentence.\');\n\n  const submit = makeSubmitButton(\'Compare my answer\');\n  submit.addEventListener(\'click\', () => submitActivity(activity, answer.value));\n  responseArea.append(label, answer, submit);\n}\n\nfunction renderGuidedDiary(activity) {\n  const config = activity.options || {};\n  const diary = document.createElement(\'div\');\n  diary.className = \'guided-diary\';\n\n  const prompt = document.createElement(\'p\');\n  prompt.className = \'guided-diary-prompt\';\n  prompt.textContent = config.prompt || \'Write about a time you had a secret, like Mandu.\';\n\n  const greeting = document.createElement(\'strong\');\n  greeting.className = \'guided-diary-greeting\';\n  greeting.textContent = \'Dear Diary,\';\n\n  const feelingLine = document.createElement(\'label\');\n  feelingLine.className = \'diary-line diary-feeling-line\';\n  const feelingCopy = document.createElement(\'span\');\n  feelingCopy.textContent = \'Today I felt\';\n  const feeling = document.createElement(\'select\');\n  feeling.dataset.field = \'feeling\';\n  feeling.innerHTML = \'<option value="">Choose a feeling</option>\';\n  (config.feelings || []).forEach((item) => {\n    const option = document.createElement(\'option\');\n    option.value = item;\n    option.textContent = item;\n    feeling.appendChild(option);\n  });\n  const becauseCopy = document.createElement(\'span\');\n  becauseCopy.textContent = \'because\';\n  feelingLine.append(feelingCopy, feeling, becauseCopy);\n\n  const because = document.createElement(\'textarea\');\n  because.className = \'diary-text-entry\';\n  because.dataset.field = \'because\';\n  because.rows = 2;\n  because.maxLength = 300;\n  because.placeholder = \'Explain what happened.\';\n  feelingLine.appendChild(because);\n\n  const bestPart = document.createElement(\'label\');\n  bestPart.className = \'diary-line\';\n  bestPart.innerHTML = \'<span>The best part of my day was</span>\';\n  const bestPartInput = document.createElement(\'textarea\');\n  bestPartInput.className = \'diary-text-entry\';\n  bestPartInput.dataset.field = \'best_part\';\n  bestPartInput.rows = 2;\n  bestPartInput.maxLength = 300;\n  bestPartInput.placeholder = \'Write the best part.\';\n  bestPart.appendChild(bestPartInput);\n\n  const nextTime = document.createElement(\'label\');\n  nextTime.className = \'diary-line\';\n  nextTime.innerHTML = \'<span>Next time I would like to</span>\';\n  const nextTimeInput = document.createElement(\'textarea\');\n  nextTimeInput.className = \'diary-text-entry\';\n  nextTimeInput.dataset.field = \'next_time\';\n  nextTimeInput.rows = 2;\n  nextTimeInput.maxLength = 300;\n  nextTimeInput.placeholder = \'Write what you would like to do.\';\n  nextTime.appendChild(nextTimeInput);\n\n  const signature = document.createElement(\'label\');\n  signature.className = \'diary-line diary-signature\';\n  const signatureCopy = document.createElement(\'span\');\n  signatureCopy.textContent = \'From\';\n  const signatureInput = document.createElement(\'input\');\n  signatureInput.type = \'text\';\n  signatureInput.dataset.field = \'from_name\';\n  signatureInput.maxLength = 100;\n  signatureInput.value = childName;\n  signature.append(signatureCopy, signatureInput);\n\n  diary.append(prompt, greeting, feelingLine, bestPart, nextTime, signature);\n  const submit = makeSubmitButton(\'Save my diary\');\n  submit.addEventListener(\'click\', () => {\n    const answer = {};\n    diary.querySelectorAll(\'[data-field]\').forEach((field) => answer[field.dataset.field] = field.value);\n    submitActivity(activity, answer);\n  });\n  responseArea.append(diary, submit);\n}\n\nfunction renderActivity() {\n  if (current >= activities.length) {\n    saveScore();\n    updateProgress();\n    const finalLink = document.querySelector(\'#results-area a\');\n    if (finalLink) finalLink.href = `/lessons/${lessonId}/results`;\n    if (finalLink) finalLink.textContent = \'View my score\';\n    document.getElementById(\'question-area\').classList.add(\'hidden\');\n    document.getElementById(\'results-area\').classList.remove(\'hidden\');\n    document.getElementById(\'results-copy\').textContent = `You completed all ${activityGroups.length} story activities.`;\n    setMascot(\'happy\', \'You worked through the whole story.\');\n    return;\n  }\n\n  const activity = activities[current];\n  const group = activityGroups.find((item) => item.indexes.includes(current));\n  const totalInGroup = group ? group.indexes.length : 1;\n  const questionNumber = group ? group.indexes.indexOf(current) + 1 : 1;\n  responseArea.innerHTML = \'\';\n  responseArea.dataset.activityType = activity.activity_type;\n  messageArea.className = \'message-area hidden\';\n  messageArea.innerHTML = \'\';\n  nextButton.classList.add(\'hidden\');\n  document.getElementById(\'activity-number\').textContent = `Activity ${group ? group.number : current + 1}`;\n  document.getElementById(\'question-number\').textContent = `Question ${questionNumber}/${totalInGroup}`;\n  document.getElementById(\'skill-label\').textContent = activityTitle(activity, group);\n  const config = activityConfig(activity);\n  const isGradeOnePhonics = config.presentation === \'grade1_phonics\';\n  const isMatchIt = activity.group_title === \'Match It!\';\n  const isFixMistake = activity.group_title === \'Fix the Mistake\';\n  const isVisualMatch = activity.group_title === \'Visual Matching\';\n  const instruction = isMatchIt\n    ? \'Choose a match for all four, then check your answers. One option on the right belongs to no one. Match each one on the left to what happened on the right.\'\n    : isVisualMatch\n      ? \'Look at the picture, then choose the word that names it.\'\n      : isFixMistake\n        ? `One word in this sentence is wrong. Choose the word that belongs in the story. ${activity.question}`\n        : config.instruction\n          || typeInstructions[activity.activity_type]\n          || \'Use the story to answer.\';\n  document.getElementById(\'activity-instruction\').textContent = instruction;\n  const questionText = document.getElementById(\'question-text\');\n  delete questionText.dataset.speechText;\n  questionText.textContent = activity.question;\n  questionText.classList.toggle(\'hidden\', isGradeOnePhonics);\n  setMascot(\'ready\', \'Take your time and use the story.\');\n  updateProgress();\n  renderActivityMedia(activity, questionText, instruction);\n\n  if (activity.options && activity.options.writing_template) {\n    renderGuidedDiary(activity);\n  } else if (activity.activity_type === \'crossword\') {\n    renderCrossword(activity);\n  } else if (activity.activity_type === \'matching\' && !Array.isArray(activity.options)) {\n    renderMatching(activity);\n  } else if (activity.activity_type === \'word_scramble\') {\n    renderWordScramble(activity);\n  } else if (activity.activity_type === \'sequencing\') {\n    renderSequence(activity);\n  } else if (activity.activity_type === \'cloze\') {\n    renderCloze(activity);\n  } else if (activity.activity_type === \'oral_response\') {\n    renderOral(activity);\n  } else if ([\'open_ended\', \'prediction\', \'reasoning\'].includes(activity.activity_type)) {\n    renderWritten(activity);\n  } else {\n    renderChoice(activity);\n  }\n}\n\nfunction disableResponses() {\n  responseArea.querySelectorAll(\'button, textarea, input, select\').forEach((element) => element.disabled = true);\n}\n\nfunction markChoice(selectedButton, data) {\n  if (!selectedButton) return;\n  selectedButton.classList.add(data.correct ? \'choice-correct\' : \'choice-wrong\');\n  if (!data.correct) {\n    responseArea.querySelectorAll(\'.btn-option\').forEach((button) => {\n      if (button.dataset.answer === data.correct_answer) button.classList.add(\'choice-correct\');\n    });\n  }\n}\n\nfunction markMatchingAnswers(data) {\n  const expectedAnswers = data.correct_answer;\n  if (!expectedAnswers || typeof expectedAnswers !== \'object\') return;\n\n  responseArea.querySelectorAll(\'.drag-match-target\').forEach((target) => {\n    const promptKey = target.dataset.prompt;\n    if (!promptKey) return;\n    const isCorrect = String(expectedAnswers[promptKey] || \'\') === target.dataset.choice;\n    target.classList.add(isCorrect ? \'match-correct\' : \'match-wrong\');\n    const badge = document.createElement(\'span\');\n    badge.className = \'matching-result-badge\';\n    badge.textContent = isCorrect ? \'Correct\' : \'Incorrect\';\n    target.appendChild(badge);\n  });\n\n  const gradeFourCards = responseArea.querySelectorAll(\'.matching-prompt-card\');\n  if (gradeFourCards.length) {\n    gradeFourCards.forEach((card) => {\n      const promptKey = card.dataset.prompt;\n      const selection = window.sgilaCurrentMatches && window.sgilaCurrentMatches[promptKey];\n      const choiceKey = selection || card.dataset.choice || \'\';\n      const correctValue = String(expectedAnswers[promptKey] || \'\');\n      const isCorrect = choiceKey === correctValue;\n      card.classList.add(isCorrect ? \'match-correct\' : \'match-wrong\');\n\n      const badge = document.createElement(\'span\');\n      badge.className = \'matching-result-badge\';\n      badge.textContent = isCorrect ? \'Correct\' : \'Incorrect\';\n      card.appendChild(badge);\n    });\n    return;\n  }\n\n  responseArea.querySelectorAll(\'.matching-pair[data-prompt]\').forEach((pair) => {\n    const correctValue = String(expectedAnswers[pair.dataset.prompt] || \'\');\n    const isCorrect = pair.dataset.choice === correctValue;\n    pair.classList.add(isCorrect ? \'match-correct\' : \'match-wrong\');\n    const badge = document.createElement(\'span\');\n    badge.className = \'matching-result-badge\';\n    badge.textContent = isCorrect ? \'Correct\' : \'Incorrect\';\n    pair.appendChild(badge);\n  });\n\n  responseArea.querySelectorAll(\'.matching-word:not([hidden])\').forEach((word) => {\n    const correctValue = String(expectedAnswers[word.dataset.prompt] || \'\');\n    const isCorrect = word.dataset.choice === correctValue;\n    word.classList.add(isCorrect ? \'match-correct\' : \'match-wrong\');\n    const badge = document.createElement(\'span\');\n    badge.className = \'matching-result-badge\';\n    badge.textContent = isCorrect ? \'Correct\' : \'Incorrect\';\n    word.appendChild(badge);\n  });\n  responseArea.querySelectorAll(\'.matching-row\').forEach((row) => {\n    if (row.dataset.choice !== undefined) {\n      const correctValue = String(expectedAnswers[row.dataset.prompt] || \'\');\n      const isCorrect = row.dataset.choice === correctValue;\n      row.classList.add(isCorrect ? \'match-correct\' : \'match-wrong\');\n      const badge = document.createElement(\'span\');\n      badge.className = \'matching-result-badge\';\n      badge.textContent = isCorrect ? \'Correct\' : \'Incorrect\';\n      row.querySelector(\'strong\').appendChild(badge);\n      return;\n    }\n    const select = row.querySelector(\'select\');\n    const correctValue = String(expectedAnswers[select.dataset.prompt] || \'\');\n    const isCorrect = select.value === correctValue;\n    row.classList.add(isCorrect ? \'match-correct\' : \'match-wrong\');\n\n    const badge = document.createElement(\'span\');\n    badge.className = \'matching-result-badge\';\n    badge.textContent = isCorrect ? \'Correct\' : \'Incorrect\';\n    row.querySelector(\'strong\').appendChild(badge);\n  });\n}\n\nfunction normaliseCheckedWord(value) {\n  return String(value || \'\')\n    .trim()\n    .toLowerCase()\n    .replace(/[.,!?;:"\'()[\\]{}-]/g, \'\')\n    .replace(/\\s+/g, \' \');\n}\n\nfunction markScrambleAnswers(data) {\n  const expectedAnswers = data.correct_answer;\n  if (\n    responseArea.dataset.activityType !== \'word_scramble\'\n    || !expectedAnswers\n    || typeof expectedAnswers !== \'object\'\n  ) return;\n\n  responseArea.querySelectorAll(\'.scramble-row\').forEach((row) => {\n    const input = row.querySelector(\'input\');\n    const correctValue = String(expectedAnswers[input.dataset.item] || \'\');\n    const isCorrect = normaliseCheckedWord(input.value) === normaliseCheckedWord(correctValue);\n    row.classList.add(isCorrect ? \'scramble-correct\' : \'scramble-wrong\');\n\n    const badge = document.createElement(\'span\');\n    badge.className = \'scramble-result-badge\';\n    badge.textContent = isCorrect ? \'Correct\' : \'Incorrect\';\n    row.querySelector(\'strong\').appendChild(badge);\n\n    if (!isCorrect) {\n      const correction = document.createElement(\'span\');\n      correction.className = \'scramble-correction\';\n      correction.textContent = `Correct spelling: ${correctValue}`;\n      row.appendChild(correction);\n    }\n  });\n}\n\nfunction showFeedback(data) {\n  messageArea.classList.remove(\'hidden\', \'correct\', \'wrong\', \'review\');\n  messageArea.classList.add(data.review_required ? \'review\' : (data.correct ? \'correct\' : \'wrong\'));\n\n  const heading = document.createElement(\'strong\');\n  heading.textContent = data.saved\n    ? \'Diary saved\'\n    : data.review_required\n    ? \'Compare your thinking\'\n    : (data.correct ? \'Correct\' : (data.partial ? `${data.score_awarded} of ${data.score_possible} correct` : \'Look at the story answer\'));\n  const message = document.createElement(\'span\');\n  message.textContent = data.message;\n  messageArea.append(heading, message);\n\n  if (data.model_answer) {\n    const model = document.createElement(\'p\');\n    model.className = \'model-answer\';\n    model.textContent = `${data.review_required ? \'Example answer\' : \'Story answer\'}: ${data.model_answer}`;\n    messageArea.appendChild(model);\n  }\n}\n\nasync function submitActivity(activity, answer, selectedButton = null) {\n  if (typeof answer === \'string\' && !answer.trim()) {\n    messageArea.className = \'message-area wrong\';\n    messageArea.textContent = \'Add your answer before continuing.\';\n    return;\n  }\n  if (answer && typeof answer === \'object\' && !Array.isArray(answer)) {\n    const values = Object.values(answer);\n    if (!values.length || values.some((value) => !String(value || \'\').trim())) {\n      messageArea.className = \'message-area wrong\';\n      messageArea.textContent = \'Complete every answer before checking this activity.\';\n      return;\n    }\n  }\n\n  const isLegacy = !activity.activity_id;\n  const endpoint = isLegacy ? \'/api/check-answer\' : \'/api/check-reading-activity\';\n  const payload = {\n    child_id: childId,\n    lesson_id: lessonId,\n    child_answer: answer,\n  };\n  if (isLegacy) payload.question_id = activity.question_id;\n  else payload.activity_id = activity.activity_id;\n\n  const response = await fetch(endpoint, {\n    method: \'POST\',\n    headers: {\'Content-Type\': \'application/json\'},\n    body: JSON.stringify(payload),\n  });\n  const data = await response.json();\n  if (!response.ok) {\n    messageArea.className = \'message-area wrong\';\n    messageArea.textContent = data.error || \'Your answer could not be checked.\';\n    return;\n  }\n\n  disableResponses();\n  completedCount++;\n  score = Number(data.comprehension_score || 0);\n  markChoice(selectedButton, data);\n  markMatchingAnswers(data);\n  markScrambleAnswers(data);\n  showFeedback(data);\n  setMascot(data.review_required || data.correct ? \'happy\' : \'sad\', data.review_required ? \'Good thinking. Compare your answer.\' : (data.correct ? \'Great reading!\' : \'Use the story answer to learn.\'));\n  const nextActivity = activities[current + 1];\n  nextButton.textContent = current === activities.length - 1\n    ? \'Finish activities\'\n    : (nextActivity.group_number === activity.group_number ? \'Next question\' : `Start Activity ${nextActivity.group_number}`);\n  nextButton.classList.remove(\'hidden\');\n  updateProgress();\n}\n\nasync function loadActivities() {\n  try {\n    const response = await fetch(`/api/lessons/${lessonId}/questions`, {cache: \'no-store\'});\n    if (!response.ok) throw new Error(\'Activities could not be loaded.\');\n    activities = await response.json();\n    const groups = new Map();\n    activities.forEach((activity, index) => {\n      activity.group_number = Number(activity.group_number || index + 1);\n      activity.group_title = activity.group_title || \'Story activity\';\n      if (!groups.has(activity.group_number)) {\n        groups.set(activity.group_number, {number: activity.group_number, title: activity.group_title, indexes: []});\n      }\n      groups.get(activity.group_number).indexes.push(index);\n    });\n    activityGroups = [...groups.values()];\n    if (!activities.length) {\n      document.getElementById(\'question-area\').classList.add(\'hidden\');\n      document.getElementById(\'results-area\').classList.remove(\'hidden\');\n      document.getElementById(\'results-copy\').textContent = \'No comprehension activities have been added yet.\';\n      updateProgress();\n      return;\n    }\n    renderActivity();\n  } catch (error) {\n    messageArea.className = \'message-area wrong\';\n    messageArea.textContent = error.message;\n  }\n}\n\nnextButton.addEventListener(\'click\', () => {\n  if (current >= activities.length - 1) {\n    window.location.assign(`/lessons/${lessonId}/results`);\n    return;\n  }\n  current++;\n  renderActivity();\n});\n\nwindow.onerror = function(msg, url, line, col, error) {\n  console.error(\'Global error:\', msg, error);\n  if (messageArea) {\n    messageArea.className = \'message-area wrong\';\n    messageArea.textContent = \'Error: \' + msg;\n  }\n};\n\nloadActivities();\n</script>\n{% endblock %}\n'

