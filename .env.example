DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000

# SQLite is the clean-machine default. Use postgresql for a shared deployment.
DB_ENGINE=sqlite
# DB_NAME=sgila_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# SMTP configuration for support-ticket notifications and account emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sgila.info@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=SGILA <sgila.info@gmail.com>
SUPPORT_EMAIL=sgila.info@gmail.com

# Optional AI story generation. Leave API keys blank to disable the feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
POLLINATIONS_MODEL=flux
POLLINATIONS_API_KEY=
