DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000

# SQLite is the clean-machine default. Use postgresql for a shared deployment.
DB_ENGINE=sqlite
# DB_NAME=sgila_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Optional SMTP configuration. SMTP is selected automatically when both the
# email address and a real app password are set. Otherwise messages print in
# the runserver terminal for local testing.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=SGILA <your-email@example.com>

# Optional AI story generation. Leave API keys blank to disable the feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest  
POLLINATIONS_MODEL=flux
POLLINATIONS_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
